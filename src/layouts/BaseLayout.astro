---
import "../styles/global.css";
import "../styles/premium.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import LanguageLinks from "../components/LanguageLinks.astro";
import { alternatesFor } from "../data/languageTools";
import { BRAND_LOGO } from "../config/brand";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  type?: "website" | "article";
  /** Document language (BCP 47). Defaults to English; Open Graph locale follows it. */
  lang?: string;
  /** Text direction of the page content. The shared English header and footer always stay left-to-right. */
  dir?: "ltr" | "rtl";
}

const {
  title,
  description,
  canonicalUrl: canonicalUrlOverride,
  image = "/social-card.svg",
  type = "website",
  lang = "en",
  dir,
} = Astro.props;
const ogLocale = lang.replace("-", "_");
// The shared header, footer and skip link are English, so they are labelled as such on pages in another language.
const chromeLang = lang === "en" ? undefined : "en";
const canonical = new URL(canonicalUrlOverride ?? Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const alternates = alternatesFor(canonicalUrlOverride ?? Astro.url.pathname);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7FAFF" />
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-5048291410050597" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={BRAND_LOGO} sizes="768x768" />
    <link rel="apple-touch-icon" href={BRAND_LOGO} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Paul Digital" />
    {lang !== "en" && <meta property="og:locale" content={ogLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paul Digital — Simple Utilities. Powerful Results." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, Astro.site)} />)}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content" lang={chromeLang} dir={dir ? "ltr" : undefined}>Skip to content</a>
    {chromeLang ? <div lang={chromeLang} dir={dir ? "ltr" : undefined} style="display: contents"><SiteHeader currentPath={Astro.url.pathname} /></div> : <SiteHeader currentPath={Astro.url.pathname} />}
    <main id="main-content">
      <slot />
      <RelatedGuides />
      <LanguageLinks />
    </main>
    {chromeLang ? <div lang={chromeLang} dir={dir ? "ltr" : undefined} style="display: contents"><SiteFooter /></div> : <SiteFooter />}
    <Analytics />
  </body>
</html>

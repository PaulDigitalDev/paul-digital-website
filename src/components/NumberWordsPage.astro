---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolTop from "./ToolTop.astro";
import NumberWordsTool from "./tools/NumberWordsTool";
import { numberWordToolBySlug } from "../data/numberWordTools";
import { toolById } from "../data/toolRegistry";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = numberWordToolBySlug.get(slug);
if (!tool) throw new Error(`Unknown number-to-words tool: ${slug}`);

const path = `/${tool.slug}/`;
const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\u003c");

const related = tool.related
  .map((id) => toolById.get(id))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .map((item) => ({ route: item.route, label: item.name }));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: "Number to Words", item: site("/tools/numbers/") },
    { "@type": "ListItem", position: 3, name: tool.h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.h1,
  url: site(path),
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  inLanguage: "en",
  operatingSystem: "Any (web browser)",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={tool.title} description={tool.description} canonicalUrl={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop accent="convert" h1={tool.h1} intro={tool.intro} crumbs={[{ label: "Home", href: "/" }, { label: "Number to Words", href: "/tools/numbers/" }, { label: tool.h1 }]} breadcrumbLabel="Breadcrumb">
      <NumberWordsTool client:load mode={tool.mode} lang={tool.lang} currency={tool.currency} system={tool.system} sample={tool.sample} />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>How to use it</h2>
      <ol>
        {tool.steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>About this tool</h2>
      {tool.explanation.map((text) => <p>{text}</p>)}

      <h2>Examples</h2>
      <ul>
        {tool.worked().map((item) => <li>{item}</li>)}
      </ul>

      <h2>Tips</h2>
      <ul>
        {tool.tips.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Questions and answers</h2>
      <div class="faq-list">
        {
          tool.faqs.map((faq) => (
            <div class="faq-item">
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </div>
          ))
        }
      </div>

      <h2>More tools</h2>
      <ul class="ic-links">
        {related.map((item) => <li><a href={item.route}>{item.label}</a></li>)}
        <li><a href="/tools/numbers/">All number to words tools</a></li>
      </ul>

      <h2>Privacy</h2>
      <p>The conversion runs in your browser on your own device. Nothing you type is sent to Paul Digital or any other server. The words follow standard writing rules, but you are responsible for what you write, so check important documents before you use them.</p>
    </div>
  </section>
</BaseLayout>

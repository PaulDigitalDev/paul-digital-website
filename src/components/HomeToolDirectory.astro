---
// Compact homepage directory. A tool is a link only when a real page exists for it; the rest are shown without a link.
interface Entry {
  name: string;
  href?: string;
}
interface Group {
  id: string;
  title: string;
  kind: "pdf" | "docx" | "image";
  tools: Entry[];
}

const groups: Group[] = [
  {
    id: "pdf",
    title: "PDF Tools",
    kind: "pdf",
    tools: [
      { name: "PDF to Word" },
      { name: "Word to PDF" },
      { name: "PDF Splitter" },
      { name: "Juntar PDF", href: "/juntar-pdf/" },
      { name: "PDF Compressor" },
      { name: "PDF Reader" },
    ],
  },
  {
    id: "docx",
    title: "DOCX Tools",
    kind: "docx",
    tools: [{ name: "DOCX Viewer" }, { name: "DOCX to PDF" }, { name: "DOCX to TXT" }],
  },
  {
    id: "image",
    title: "Image Tools",
    kind: "image",
    tools: [{ name: "JPG para PDF", href: "/jpg-para-pdf/" }, { name: "PDF to Image" }],
  },
];

// 28px icons drawn on a 28-unit grid; each kind has its own color and a small glyph.
const icons: Record<Group["kind"], string> = {
  pdf: '<rect width="28" height="28" rx="6" fill="#E5322D"/><path d="M8 6h8l4 4v12H8z" fill="#fff"/><path d="M16 6v4h4" fill="none" stroke="#E5322D" stroke-width="1.3"/><rect x="5" y="14" width="13" height="7" rx="1.6" fill="#FF6B00"/><path d="M7.8 19v-3.4h1.4a1 1 0 0 1 0 2H7.8M11 19v-3.4h.9a1.7 1.7 0 0 1 0 3.4zM15.8 15.6h-1.5V19M14.3 17.2h1.3" fill="none" stroke="#fff" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>',
  docx: '<rect width="28" height="28" rx="6" fill="#087FEA"/><path d="M8 6h8l4 4v12H8z" fill="#fff"/><path d="M16 6v4h4" fill="none" stroke="#087FEA" stroke-width="1.3"/><rect x="5" y="14" width="13" height="7" rx="1.6" fill="#0B1F5E"/><path d="m7.4 15.8.9 3 .9-3 .9 3 .9-3" fill="none" stroke="#fff" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>',
  image: '<rect width="28" height="28" rx="6" fill="#F5B301"/><rect x="6" y="7" width="16" height="14" rx="2.5" fill="#fff"/><circle cx="11" cy="12" r="1.7" fill="#FF6B00"/><path d="M7.5 20 13 14.5l3 3 2.2-2.2L22 19v.5a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 7.5 19.5z" fill="#16B364"/>',
};
---

<section class="td-page" aria-labelledby="tools-heading">
  <div class="container">
    <div class="td-intro">
      <h1 id="tools-heading">Paul <span class="brand-accent">Digital</span> — Free Online Tools</h1>
      <p>Simple utilities that run in your browser. Your files are not uploaded.</p>
    </div>

    <div class="td-directory">
      {
        groups.map((group) => (
          <section class="td-group" aria-labelledby={`td-${group.id}`}>
            <h2 id={`td-${group.id}`}>{group.title}</h2>
            <ul class="td-list">
              {group.tools.map((tool) => (
                <li>
                  {tool.href ? (
                    <a class="td-item" href={tool.href}>
                      <svg class="td-icon" viewBox="0 0 28 28" width="26" height="26" aria-hidden="true" focusable="false" set:html={icons[group.kind]} />
                      <span>{tool.name}</span>
                    </a>
                  ) : (
                    <span class="td-item">
                      <svg class="td-icon" viewBox="0 0 28 28" width="26" height="26" aria-hidden="true" focusable="false" set:html={icons[group.kind]} />
                      <span>{tool.name}</span>
                      <span class="td-soon">Coming soon</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

---
// Compact homepage directory, built from the tool registry (see src/data/homeDirectory.ts).
import { buildDirectory, type DirectoryIcon } from "../data/homeDirectory";

const groups = buildDirectory();

// 28px icons drawn on a 28-unit grid; each kind has its own color and a small glyph.
const icons: Record<DirectoryIcon, string> = {
  pdf: '<rect width="28" height="28" rx="6" fill="#E5322D"/><path d="M8 6h8l4 4v12H8z" fill="#fff"/><path d="M16 6v4h4" fill="none" stroke="#E5322D" stroke-width="1.3"/><rect x="5" y="14" width="13" height="7" rx="1.6" fill="#FF6B00"/><path d="M7.8 19v-3.4h1.4a1 1 0 0 1 0 2H7.8M11 19v-3.4h.9a1.7 1.7 0 0 1 0 3.4zM15.8 15.6h-1.5V19M14.3 17.2h1.3" fill="none" stroke="#fff" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>',
  docx: '<rect width="28" height="28" rx="6" fill="#087FEA"/><path d="M8 6h8l4 4v12H8z" fill="#fff"/><path d="M16 6v4h4" fill="none" stroke="#087FEA" stroke-width="1.3"/><rect x="5" y="14" width="13" height="7" rx="1.6" fill="#0B1F5E"/><path d="m7.4 15.8.9 3 .9-3 .9 3 .9-3" fill="none" stroke="#fff" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>',
  image: '<rect width="28" height="28" rx="6" fill="#F5B301"/><rect x="6" y="7" width="16" height="14" rx="2.5" fill="#fff"/><circle cx="11" cy="12" r="1.7" fill="#FF6B00"/><path d="M7.5 20 13 14.5l3 3 2.2-2.2L22 19v.5a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 7.5 19.5z" fill="#16B364"/>',
  text: '<rect width="28" height="28" rx="6" fill="#6C4DE6"/><rect x="7" y="6" width="14" height="16" rx="2" fill="#fff"/><path d="M10 11h8M10 14.5h8M10 18h5" stroke="#6C4DE6" stroke-width="1.5" stroke-linecap="round"/>',
  convert: '<rect width="28" height="28" rx="6" fill="#0E9F8E"/><path d="M8 11h10l-2.5-2.5M20 17H10l2.5 2.5" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>',
  photo: '<rect width="28" height="28" rx="6" fill="#2F5BEA"/><rect x="7" y="6" width="14" height="16" rx="2" fill="#fff"/><circle cx="14" cy="12" r="2.6" fill="#2F5BEA"/><path d="M9.5 20c.6-2.6 2.4-3.8 4.5-3.8s3.9 1.2 4.5 3.8z" fill="#2F5BEA"/>',
  social: '<rect width="28" height="28" rx="6" fill="#E1306C"/><rect x="7" y="7" width="14" height="14" rx="4" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="14" cy="14" r="3.2" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="18.2" cy="9.8" r="1" fill="#fff"/>',
};
---

<section class="td-page" aria-labelledby="tools-heading">
  <div class="container">
    <div class="td-intro">
      <h1 id="tools-heading">Paul <span class="brand-accent">Digital</span> — Free Online Tools</h1>
      <p>Simple utilities that run in your browser. Your files are not uploaded.</p>
    </div>

    <div class="td-directory">
      {
        groups.map((group) => (
          <section class="td-group" aria-labelledby={`td-${group.id}`} lang={group.lang} dir={group.dir}>
            <h2 id={`td-${group.id}`}>{group.title}</h2>
            <ul class="td-list">
              {group.tools.map((tool) => (
                <li>
                  <a class="td-item" href={tool.href}>
                    <svg class="td-icon" viewBox="0 0 28 28" width="26" height="26" aria-hidden="true" focusable="false" set:html={icons[group.icon]} />
                    <span>{tool.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

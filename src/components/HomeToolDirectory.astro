---
// Homepage tool grid: one card per tool (colour icon, name, short description), category filter tabs,
// popular target-size shortcuts, and the localized tool groups. Built from the tool registry via
// src/data/homeDirectory.ts, which fails the build if a tool is missing from the homepage.
import { buildDirectory } from "../data/homeDirectory";
import { toolById } from "../data/toolRegistry";
import { imageSizeRoutes } from "../data/imageSizeRoutes";

const groups = buildDirectory();

const tabs: Record<string, { label: string; color: string }> = {
  pdf: { label: "PDF", color: "#E5322D" },
  docx: { label: "Word & Text", color: "#2563EB" },
  image: { label: "Edit Images", color: "#12A150" },
  convert: { label: "Convert", color: "#0E9F8E" },
  photo: { label: "Photos for Forms", color: "#4F46E5" },
  social: { label: "Social Media", color: "#DB2777" },
  calculators: { label: "Calculators", color: "#6D4AFF" },
  calendars: { label: "Calendars", color: "#0E7490" },
  numbers: { label: "Number to Words", color: "#B45309" },
  land: { label: "Land", color: "#15803D" },
  text: { label: "Text", color: "#7C3AED" },
};

// Simple white glyphs drawn on a 24-unit grid, one per kind of job.
const glyphs: Record<string, string> = {
  cal: '<rect x="4" y="5.5" width="16" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  calc: '<rect x="5" y="3.5" width="14" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 7.5h7M8.5 12h.1M12 12h.1M15.5 12h.1M8.5 16h.1M12 16h.1M15.5 16h.1" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>',
  pdf: '<path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3v4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.5 13h5M9.5 16.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  word: '<path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9 11 1.2 5 1.8-4 1.8 4 1.2-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  text: '<path d="M5 6h14M12 6v13M8.5 19h7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  image: '<rect x="3.5" y="5" width="17" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="10" r="1.7" fill="currentColor"/><path d="m4.5 17.5 5-5 3.2 3.2 2.3-2.3 4.5 4.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  compress: '<path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  resize: '<path d="M4 9V4h5M20 15v5h-5M4 4l6.5 6.5M20 20l-6.5-6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  crop: '<path d="M7 3v14h14M3 7h14v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  info: '<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v5.5M12 7.6v.1" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>',
  star: '<path d="m12 4 2.4 5 5.4.6-4 3.7 1.1 5.4L12 16l-4.9 2.7 1.1-5.4-4-3.7 5.4-.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  convert: '<path d="M5 9h12l-3-3M19 15H7l3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  photo: '<rect x="5" y="3.5" width="14" height="17" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.7" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 17.5c.7-2.2 2.2-3.2 4-3.2s3.3 1 4 3.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  sign: '<path d="M3.5 17c2.5-.2 4-4.5 5.5-8.5.8-2 2.4-1.2 1.6.8-1 2.6-1.4 5.8.6 5.7 1.5-.1 2.3-3 3.6-3 1.1 0 .4 2.6 1.6 2.6 1 0 1.7-1.3 2.6-1.3M3.5 20.5h17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  social: '<rect x="4" y="4" width="16" height="16" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="16.8" cy="7.2" r="1.1" fill="currentColor"/>',
  grid: '<path d="M4 4h16v16H4zM9.3 4v16M14.7 4v16M4 9.3h16M4 14.7h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  chat: '<path d="M4.5 19.5 6 15.6A7.5 7.5 0 1 1 9 18.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  play: '<rect x="3" y="5.5" width="18" height="13" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m10.5 9.5 4 2.5-4 2.5z" fill="currentColor"/>',
  zoom: '<circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15 15 5 5M8 10.5h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
};

const glyphFor: Record<string, string> = {
  "jpg-to-pdf": "pdf",
  "image-to-word": "word",
  "jpg-to-text": "text",
  "png-to-text": "text",
  "image-compressor": "compress",
  "image-resizer": "resize",
  "crop-rotate-flip-image": "crop",
  "image-metadata": "info",
  "favicon-generator": "star",
  "passport-photo-resizer": "photo",
  "uk-passport-photo-digital": "photo",
  "signature-resizer": "sign",
  "government-job-photo-signature-resizer": "photo",
  "resize-image-for-instagram": "social",
  "instagram-grid": "grid",
  "resize-image-for-whatsapp-dp": "chat",
  "resize-image-for-youtube-banner": "play",
  "zoom-out-image": "zoom",
};

const hrefToId = new Map<string, string>();
for (const tool of toolById.values()) hrefToId.set(tool.route, tool.id);

const englishGroups = groups.filter((g) => tabs[g.id]);
const localized = groups.filter((g) => !tabs[g.id]);

const cards = englishGroups.flatMap((group) =>
  group.tools
    .filter((entry) => hrefToId.has(entry.href))
    .map((entry) => {
      const id = hrefToId.get(entry.href)!;
      const tool = toolById.get(id)!;
      return {
        cat: group.id,
        name: entry.name,
        href: entry.href,
        description: tool.description,
        color: tabs[group.id].color,
        glyph: glyphs[glyphFor[id] ?? (group.id === "convert" ? "convert" : group.id === "calculators" ? "calc" : group.id === "calendars" ? "cal" : ["numbers", "land", "text"].includes(group.id) ? "convert" : "image")],
      };
    }),
);

// Shortcuts to the most searched exact sizes.
const extraPills = englishGroups.flatMap((g) => g.tools.filter((t) => !hrefToId.has(t.href)));
const compressPills = imageSizeRoutes
  .filter((r) => ["compress-image-to-20kb", "compress-image-to-50kb", "compress-image-to-100kb", "compress-image-to-200kb", "compress-jpeg-to-30kb", "compress-image-to-1mb"].includes(r.slug))
  .map((r) => ({ name: r.h1, href: `/${r.slug}/` }));
const pills = [...compressPills, ...extraPills];
---

<section class="hg" aria-labelledby="tools-heading">
  <div class="container">
    <div class="hg-head">
      <h1 id="tools-heading">Free online tools for images, PDFs and calculators</h1>
      <p>Compress, resize and convert files, or work out loans, dates, grades and more. Everything runs in your browser, so nothing is uploaded.</p>
    </div>

    <div class="hg-tabs" role="group" aria-label="Filter tools by category" hidden data-hg-tabs>
      <button type="button" class="hg-tab" aria-pressed="true" data-filter="all">All tools</button>
      {Object.entries(tabs).map(([id, tab]) => (
        <button type="button" class="hg-tab" aria-pressed="false" data-filter={id}>{tab.label}</button>
      ))}
    </div>

    <ul class="hg-grid" data-hg-grid>
      {
        cards.map((card) => (
          <li class="hg-card" data-cat={card.cat} style={`--c: ${card.color}`}>
            <a href={card.href}>
              <span class="hg-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={card.glyph} />
              </span>
              <h2>{card.name}</h2>
              <p>{card.description}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hg-popular">
      <h2>Popular sizes</h2>
      <ul class="hg-pills">
        {pills.map((pill) => <li><a href={pill.href}>{pill.name}</a></li>)}
      </ul>
    </div>

    <div class="hg-langs">
      <h2>Tools in other languages</h2>
      <div class="hg-lang-groups">
        {
          localized.map((group) => (
            <section lang={group.lang} dir={group.dir} aria-label={group.title}>
              <h3>{group.title}</h3>
              <ul>
                {group.tools.map((tool) => <li><a href={tool.href}>{tool.name}</a></li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const bar = document.querySelector<HTMLElement>("[data-hg-tabs]");
  if (bar) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-hg-grid] [data-cat]"));
    bar.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-filter]");
      if (!button) return;
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== "all" && card.dataset.cat !== filter;
      });
    });
  }
</script>

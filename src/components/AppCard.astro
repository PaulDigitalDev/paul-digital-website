---
import type { App } from "../data/apps";

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<article class="card app-card">
  <div class="card-top">
    <span class="app-icon" aria-hidden="true">{app.code}</span>
    <span class:list={["tag", "app-status", app.status === "Published" ? "tag-green" : app.status === "Coming Soon" ? "tag-neutral" : "tag-blue"]}>
      {app.status}
    </span>
  </div>
  <h2>{app.name}</h2>
  <p>{app.description}</p>
  {app.playUrl && (
    <a class="button button-primary play-link" href={app.playUrl} target="_blank" rel="noopener noreferrer">
      View on Google Play <span aria-hidden="true">→</span>
    </a>
  )}
  <a class="card-link" href={`/apps/${app.slug}/`}>View details <span aria-hidden="true">→</span></a>
</article>

---
/**
 * Shared top-of-page layout for every tool page: breadcrumb, centered heading and subtitle, then the working tool
 * (passed in the default slot). SEO text, steps, FAQs and related tools belong in a section after this one.
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  h1: string;
  intro: string;
  crumbs: Crumb[];
  breadcrumbLabel?: string;
  /** Category colour for the main buttons: pdf (red), word (blue), image (green), convert (teal), photo (indigo), social (pink), text (purple). */
  accent?: "pdf" | "word" | "image" | "convert" | "photo" | "social" | "text" | "calc";
}

const { h1, intro, crumbs, breadcrumbLabel = "Breadcrumb", accent } = Astro.props;
// Keep the heading area short, like a clean converter page: the first sentence only. The full text stays in the page content below.
const firstSentence = intro.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? intro;
const shortIntro = firstSentence.length > 140 ? `${firstSentence.slice(0, 137).trimEnd()}…` : firstSentence;
---

<section class="tool-top" data-accent={accent}>
  <div class="container">
    <nav class="breadcrumb" aria-label={breadcrumbLabel}>
      <ol>
        {
          crumbs.map((crumb) => (
            <li {...(crumb.href ? {} : { "aria-current": "page" })}>
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : crumb.label}
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="tool-head">
      <h1>{h1}</h1>
      <p>{shortIntro}</p>
    </div>
    <slot />
  </div>
</section>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolTop from "./ToolTop.astro";
import ImageResizer from "./tools/ImageResizer";
import CropEditor from "./tools/CropEditor";
import MetadataTool from "./tools/MetadataTool";
import UkPhotoCheck from "./tools/UkPhotoCheck";
import { editorToolBySlug, editorSizePages } from "../data/editorTools";
import { toolById } from "../data/toolRegistry";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = editorToolBySlug.get(slug);
if (!tool) throw new Error(`Unknown editor tool: ${slug}`);

const path = `/${tool.slug}/`;
const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "<");
const relatedLink = (id: string) => {
  const registered = toolById.get(id);
  if (registered) return { route: registered.route, name: registered.name };
  const size = editorToolBySlug.get(id);
  return size ? { route: `/${size.slug}/`, name: size.h1 } : undefined;
};
const related = tool.related.map(relatedLink).filter((item): item is { route: string; name: string } => Boolean(item));
/* Size pages are grouped under the tool that does the work, so each page links to its siblings and to its parent. */
const parentOf = { resize: "image-resizer", passport: "passport-photo-resizer", signature: "signature-resizer" } as Record<string, string>;
const isSizePage = editorSizePages.some((page) => page.slug === tool.slug);
const groupMode = isSizePage ? tool.mode : ({ "image-resizer": "resize", "passport-photo-resizer": "passport", "signature-resizer": "signature" } as Record<string, string>)[tool.slug];
const moreSizes = groupMode ? editorSizePages.filter((page) => page.mode === groupMode && page.slug !== tool.slug) : [];
const parent = isSizePage ? toolById.get(parentOf[tool.mode] ?? "") : undefined;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: "Web Tools", item: site("/tools/") },
    { "@type": "ListItem", position: 3, name: tool.h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.h1,
  url: site(path),
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any (web browser)",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={tool.title} description={tool.description} canonicalUrl={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop accent={tool.mode === "resize" ? "image" : "photo"} h1={tool.h1} intro={tool.intro} crumbs={[{ label: "Home", href: "/" }, { label: "Web Tools", href: "/tools/" }, { label: tool.h1 }]} breadcrumbLabel="Breadcrumb">
      {tool.mode === "resize" && <ImageResizer client:load start={tool.start} />}
      {tool.mode === "crop" && <CropEditor client:load variant="crop" />}
      {tool.mode === "metadata" && <MetadataTool client:load />}
      {tool.mode === "passport" && <CropEditor client:load variant="passport" fixed={tool.fixed} />}
      {tool.mode === "signature" && <CropEditor client:load variant="signature" fixed={tool.fixed} />}
      {tool.mode === "government" && <CropEditor client:load variant="government" />}
      {tool.mode === "ukdigital" && <UkPhotoCheck client:load />}
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>How to use the {tool.h1}</h2>
      <ol>
        {tool.steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>About this tool</h2>
      {tool.explanation.map((text) => <p>{text}</p>)}

      {
        tool.sources && (
          <>
            <h2>Official sources</h2>
            {tool.sources.map((source) => (
              <>
                <p>
                  <a href={source.url} rel="noopener noreferrer">{source.label}</a> — checked {source.verified}. What it says:
                </p>
                <ul>
                  {source.says.map((line) => <li>{line}</li>)}
                </ul>
              </>
            ))}
            <p>Paul Digital is not affiliated with the UK Government. Requirements can change, so confirm them on the official page before you apply.</p>
          </>
        )
      }

      <h2>Practical uses</h2>
      <ul>
        {tool.useCases.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Tips for better results</h2>
      <ul>
        {tool.tips.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {
          tool.faqs.map((faq) => (
            <div class="faq-item">
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </div>
          ))
        }
      </div>

      {
        moreSizes.length > 0 && (
          <>
            <h2>More sizes</h2>
            <ul class="ic-links">
              {parent && <li><a href={parent.route}>{parent.name} (all sizes)</a></li>}
              {moreSizes.map((page) => <li><a href={`/${page.slug}/`}>{page.h1}</a></li>)}
            </ul>
          </>
        )
      }

      <h2>Related tools</h2>
      <ul class="ic-links">
        {related.map((item) => <li><a href={item.route}>{item.name}</a></li>)}
        <li><a href="/tools/">All web tools</a></li>
      </ul>

      <h2>Privacy</h2>
      <p>Your image is processed in your browser on your own device. It is not uploaded to Paul Digital or any other server, and nothing is stored once you close the page.</p>
    </div>
  </section>
</BaseLayout>

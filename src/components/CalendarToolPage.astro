---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolTop from "./ToolTop.astro";
import BanglaCalendarTool from "./tools/BanglaCalendarTool";
import { calendarToolBySlug } from "../data/calendarTools";
import { toolById } from "../data/toolRegistry";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = calendarToolBySlug.get(slug);
if (!tool) throw new Error(`Unknown calendar tool: ${slug}`);

const path = `/${tool.slug}/`;
const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\u003c");

const related = tool.related
  .map((id) => toolById.get(id))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .map((item) => ({ route: item.route, label: item.name }));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: "Calendars", item: site("/tools/calendars/") },
    { "@type": "ListItem", position: 3, name: tool.h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.h1,
  url: site(path),
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  inLanguage: "bn",
  operatingSystem: "Any (web browser)",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={tool.title} description={tool.description} canonicalUrl={path} lang="bn">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop accent="convert" h1={tool.h1} intro={tool.intro} crumbs={[{ label: "Home", href: "/" }, { label: "Calendars", href: "/tools/calendars/" }, { label: tool.h1 }]} breadcrumbLabel="Breadcrumb">
      <BanglaCalendarTool client:load mode={tool.mode} />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>কীভাবে ব্যবহার করবেন</h2>
      <ol>
        {tool.steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>এই টুল সম্পর্কে</h2>
      {tool.explanation.map((text) => <p>{text}</p>)}

      <h2>উদাহরণ</h2>
      <ul>
        {tool.worked().map((item) => <li>{item}</li>)}
      </ul>

      <h2>কিছু পরামর্শ</h2>
      <ul>
        {tool.tips.map((item) => <li>{item}</li>)}
      </ul>

      <h2>প্রশ্ন ও উত্তর</h2>
      <div class="faq-list">
        {
          tool.faqs.map((faq) => (
            <div class="faq-item">
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </div>
          ))
        }
      </div>

      <h2>আরও টুল</h2>
      <ul class="ic-links">
        {related.map((item) => <li><a href={item.route}>{item.label}</a></li>)}
        <li><a href="/tools/calendars/">সব ক্যালেন্ডার</a></li>
      </ul>

      <h2>গোপনীয়তা</h2>
      <p>হিসাব আপনার ব্রাউজারে আপনার ডিভাইসেই হয়। আপনার দেওয়া তারিখ পল ডিজিটাল বা অন্য কোনো সার্ভারে পাঠানো হয় না। এখানকার তারিখ অনুমানভিত্তিক গণনা, সরকারি বা ধর্মীয় সিদ্ধান্তের জন্য আপনার নির্ভরযোগ্য পঞ্জিকা দেখে নিন।</p>
    </div>
  </section>
</BaseLayout>

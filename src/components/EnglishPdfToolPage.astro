---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolTop from "./ToolTop.astro";
import MergePdf from "./tools/MergePdf";
import SplitPdf from "./tools/SplitPdf";
import CompressPdf from "./tools/CompressPdf";
import PdfToWord from "./tools/PdfToWord";
import WordToPdf from "./tools/WordToPdf";
import { englishPdfTools, englishPdfToolBySlug } from "../data/englishPdfTools";
import { toolById } from "../data/toolRegistry";
import { jpgToPdfBySlug } from "../data/jpgToPdfRoutes";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = englishPdfToolBySlug.get(slug);
if (!tool) throw new Error(`Unknown English PDF tool: ${slug}`);

const path = `/${tool.slug}/`;
const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const linkFor = (id: string) => {
  const registered = toolById.get(id);
  if (registered) return { route: registered.route, name: registered.name };
  const english = englishPdfToolBySlug.get(id);
  if (english) return { route: `/${english.slug}/`, name: english.h1 };
  const jpg = jpgToPdfBySlug.get(id);
  if (jpg) return { route: `/${jpg.slug}/`, name: jpg.h1 };
  return undefined;
};
const related = tool.related.map(linkFor).filter((item): item is { route: string; name: string } => Boolean(item));
const sizePages = tool.kind === "compress" ? englishPdfTools.filter((page) => page.kind === "compress" && page.slug !== tool.slug) : [];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: "Web Tools", item: site("/tools/") },
    { "@type": "ListItem", position: 3, name: tool.h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.h1,
  url: site(path),
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any (web browser)",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={tool.title} description={tool.description} canonicalUrl={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop accent={tool.accent} h1={tool.h1} intro={tool.intro} crumbs={[{ label: "Home", href: "/" }, { label: "Web Tools", href: "/tools/" }, { label: tool.h1 }]} breadcrumbLabel="Breadcrumb">
    {tool.kind === "merge" && <MergePdf client:load locale="en" />}
    {tool.kind === "split" && <SplitPdf client:load />}
    {tool.kind === "compress" && <CompressPdf client:load targetKb={tool.targetKb} />}
    {tool.kind === "pdf-to-word" && <PdfToWord client:load />}
    {tool.kind === "word-to-pdf" && <WordToPdf client:load />}
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>How to use {tool.h1}</h2>
      <ol>
        {tool.steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>About this tool</h2>
      {tool.about.map((text) => <p>{text}</p>)}

      <h2>Limits and what to expect</h2>
      <ul>
        {tool.limits.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Tips</h2>
      <ul>
        {tool.tips.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {
          tool.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      {
        sizePages.length > 0 && (
          <>
            <h2>Compress to a target size</h2>
            <ul class="ic-links">
              {tool.slug !== "compress-pdf" && <li><a href="/compress-pdf/">Compress PDF (all levels)</a></li>}
              {sizePages.map((page) => <li><a href={`/${page.slug}/`}>{page.h1}</a></li>)}
            </ul>
          </>
        )
      }

      <h2>Related tools</h2>
      <ul class="ic-links">
        {related.map((item) => <li><a href={item.route}>{item.name}</a></li>)}
        <li><a href="/tools/">All web tools</a></li>
      </ul>

      <h2>Privacy</h2>
      <p>Your file is processed in your browser on your own device. It is not uploaded to Paul Digital or any other server, and nothing is stored once you close the page.</p>
    </div>
  </section>
</BaseLayout>

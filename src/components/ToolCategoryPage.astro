---
import BaseLayout from "../layouts/BaseLayout.astro";
import TargetSizeGrid from "./TargetSizeGrid.astro";

interface Props {
  path: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  group: string;
  openHref: string;
  openLabel: string;
  gridId: string;
  items: { href: string; label: string; ariaLabel: string }[];
  about: string[];
}

const { path, title, description, h1, intro, group, openHref, openLabel, gridId, items, about } = Astro.props;
const site = (p: string) => new URL(p, Astro.site).href;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: group, item: site("/tools/") },
    { "@type": "ListItem", position: 3, name: h1, item: site(path) },
  ],
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<BaseLayout title={title} description={description} canonicalUrl={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
  </Fragment>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/tools/">{group}</a></li>
          <li aria-current="page">{h1}</li>
        </ol>
      </nav>
      <h1>{h1}</h1>
      <p>{intro}</p>
      <div class="actions">
        <a class="button button-primary" href={openHref}>{openLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <TargetSizeGrid headingId={gridId} items={items} />
      <div class="prose target-about">
        {about.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>
</BaseLayout>

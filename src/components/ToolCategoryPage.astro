---
import BaseLayout from "../layouts/BaseLayout.astro";
import TargetSizeGrid from "./TargetSizeGrid.astro";

interface Props {
  path: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  group: string;
  openHref: string;
  openLabel: string;
  gridId: string;
  items: { href: string; label: string; ariaLabel: string }[];
  about: string[];
  /** Optional in-depth sections (trusted HTML) shown after the size grid. */
  sections?: { heading: string; html: string }[];
  faqs?: { q: string; a: string }[];
}

const { path, title, description, h1, intro, group, openHref, openLabel, gridId, items, about, sections = [], faqs = [] } = Astro.props;
const site = (p: string) => new URL(p, Astro.site).href;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: group, item: site("/tools/") },
    { "@type": "ListItem", position: 3, name: h1, item: site(path) },
  ],
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
---

<BaseLayout title={title} description={description} canonicalUrl={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    {faqs.length > 0 && <script type="application/ld+json" set:html={json(faqSchema)} />}
  </Fragment>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/tools/">{group}</a></li>
          <li aria-current="page">{h1}</li>
        </ol>
      </nav>
      <h1>{h1}</h1>
      <p>{intro}</p>
      <div class="actions">
        <a class="button button-primary" href={openHref}>{openLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <TargetSizeGrid headingId={gridId} items={items} />
      <div class="prose target-about">
        {about.map((text) => <p>{text}</p>)}
        {
          sections.map((section) => (
            <>
              <h2>{section.heading}</h2>
              <Fragment set:html={section.html} />
            </>
          ))
        }
        {
          faqs.length > 0 && (
            <>
              <h2>Frequently asked questions</h2>
              <div class="faq-list">
                {faqs.map((faq) => (
                  <div class="faq-item">
                    <h3>{faq.q}</h3>
                    <p>{faq.a}</p>
                  </div>
                ))}
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

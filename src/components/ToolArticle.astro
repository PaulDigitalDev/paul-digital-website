---
// Written article under a tool: shown on any page whose route has an entry in src/data/toolArticles.ts.
// Rendered by BaseLayout. English only (the page content and tool UI of translated pages are separate).
import { articleForRoute } from "../data/toolArticles";

const article = articleForRoute(Astro.url.pathname);
---

{
  article && (
    <section class="content-section tool-article" aria-labelledby="tool-article-h" lang="en" dir="ltr">
      <div class="container prose">
        <h2 id="tool-article-h">{article.title}</h2>
        {article.sections.map((section) => (
          <>
            <h3>{section.heading}</h3>
            <Fragment set:html={section.html} />
          </>
        ))}
        {article.faqs && article.faqs.length > 0 && (
          <>
            <h3>Common questions</h3>
            {article.faqs.map((faq) => (
              <details class="tool-article-faq">
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </>
        )}
      </div>
    </section>
  )
}

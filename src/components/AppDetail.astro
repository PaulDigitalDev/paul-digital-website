---
import type { App } from "../data/apps";

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/apps/">Apps</a></li>
        <li aria-current="page">{app.name}</li>
      </ol>
    </nav>
    <span class="eyebrow">Paul Digital app</span>
    <h1>{app.name}</h1>
    <p>{app.description}</p>
    {
      app.playUrl && (
        <div class="actions">
          <a class="button button-primary" href={app.playUrl} target="_blank" rel="noopener noreferrer">
            Get it on Google Play <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>
<section class="content-section">
  <div class="container prose">
    <p>
      <span class:list={["tag", "app-status", app.status === "Published" ? "tag-green" : app.status === "Preview" ? "tag-blue" : "tag-neutral"]}>
        {app.status}
      </span>
    </p>
    <h2>About this app</h2>
    {app.overview.map((text) => <p>{text}</p>)}

    <h2>What it is useful for</h2>
    <ul>
      {app.uses.map((use) => <li>{use}</li>)}
    </ul>

    {
      app.background && (
        <>
          <h2>{app.background.heading}</h2>
          {app.background.paragraphs.map((text) => <p>{text}</p>)}
        </>
      )
    }

    <h2>App details</h2>
    <ul>
      {app.platform && <li><strong>Platform:</strong> {app.platform}</li>}
      <li><strong>Developer:</strong> Paul Digital</li>
      {app.packageName && <li><strong>Package name:</strong> <code>{app.packageName}</code></li>}
      <li><strong>Privacy:</strong> see the <a href="/privacy/">Paul Digital privacy policy</a> and the app's Google Play listing for its permissions and data practices.</li>
      <li><strong>Support:</strong> email <a href="mailto:askpaulonline@gmail.com">askpaulonline@gmail.com</a> with the app name, your phone model and Android version.</li>
    </ul>
    {app.status === "Preview" && <p>This is a preview release. It is not yet listed on Google Play.</p>}
    {
      app.previewApkUrl && (
        <p>
          <a class="button button-primary" href={app.previewApkUrl} rel="noopener noreferrer">
            Download preview APK <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }

    {
      app.related.length > 0 && (
        <>
          <h2>Related tools and guides</h2>
          <ul>
            {app.related.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </>
      )
    }
    <p>See all <a href="/apps/">Paul Digital apps</a>.</p>
  </div>
</section>

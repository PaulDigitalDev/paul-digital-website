---
import type { App } from "../data/apps";

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Paul Digital app</span>
    <h1>{app.name}</h1>
    <p>{app.description}</p>
  </div>
</section>
<section class="content-section">
  <div class="container prose">
    <p>
      <span class:list={["tag", "app-status", app.status === "Published" ? "tag-green" : app.status === "Coming Soon" ? "tag-neutral" : "tag-blue"]}>
        {app.status}
      </span>
    </p>
    <h2>About this app</h2>
    <p>{app.purpose}</p>
    {app.platform && <p><strong>Platform:</strong> {app.platform}</p>}
    {app.packageName && <p><strong>Package name:</strong> <code>{app.packageName}</code></p>}
    {app.playUrl && (
      <p>
        <a class="button button-primary" href={app.playUrl} target="_blank" rel="noopener noreferrer">
          View on Google Play <span aria-hidden="true">→</span>
        </a>
      </p>
    )}
  </div>
</section>

---
interface Props {
  name: string;
  description: string;
  code: string;
  id?: string;
}

const { name, description, code, id } = Astro.props;
---

<article id={id} class="card tool-card">
  <div class="card-top">
    <span class="app-icon" aria-hidden="true">{code}</span>
    <span class="tag tag-blue">Coming Soon</span>
  </div>
  <h2>{name}</h2>
  <p>{description}</p>
</article>

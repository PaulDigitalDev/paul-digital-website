---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import RazdelitPdf from "../../components/tools/RazdelitPdf";

const path = "/razdelit-pdf/";
const title = "Разделить PDF онлайн бесплатно — Извлечь страницы | Paul Digital";
const description =
  "Извлеките нужные страницы из PDF бесплатно: укажите номера или диапазоны, например 1-3, 5, 8-10. Файл обрабатывается в браузере и не загружается на сервер.";
const h1 = "Разделить PDF";
const intro =
  "Извлеките из PDF нужные страницы: выберите их или укажите диапазон — бесплатно и прямо в браузере.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "Нажмите «Выберите PDF-файл» или перетащите файл в отмеченную область. Будет показано общее число страниц.",
  "Выберите способ разделения и укажите страницы: нажимайте на номера или введите, например, «1-3, 5, 8-10». Нумерация начинается с 1.",
  "Нажмите «Разделить PDF». Инструмент создаст новые PDF-файлы с выбранными страницами.",
  "Скачайте результат кнопкой «Скачать PDF». Если файлов несколько, их можно скачать ZIP-архивом или по отдельности.",
];

const faqs = [
  {
    q: "Как извлечь нужные страницы из PDF?",
    a: "Выберите PDF, нажмите на номера страниц или введите диапазон (например, 1-3, 5, 8-10) и нажмите «Разделить PDF». Из выбранных страниц будет создан новый PDF.",
  },
  {
    q: "С какой страницы начинается нумерация?",
    a: "Первая страница имеет номер 1. Если указать номер, которого нет в документе (например, 15 в документе из 12 страниц), инструмент сообщит об ошибке.",
  },
  {
    q: "Какие способы разделения доступны?",
    a: "Три: извлечь все выбранные страницы в один PDF, разделить по указанным диапазонам (каждый диапазон — отдельный PDF) и сохранить каждую страницу документа в отдельный PDF. Если файлов получилось несколько, их можно скачать одним ZIP-архивом.",
  },
  {
    q: "Можно ли изменить порядок страниц?",
    a: "Да. По умолчанию страницы извлекаются в том порядке, в котором вы их указали (например, «5, 1-2» даст сначала страницу 5, затем 1 и 2). Можно выбрать расположение по порядку исходного документа.",
  },
  {
    q: "Можно ли сохранить каждую страницу отдельным PDF?",
    a: "Да, способом «Сохранить каждую страницу в отдельный PDF». Он доступен для документов до 200 страниц; для более длинных выберите диапазон страниц.",
  },
  {
    q: "Изменится ли мой исходный файл?",
    a: "Нет. Исходный файл остаётся нетронутым, а выбранные страницы копируются в новые файлы.",
  },
  {
    q: "Загружается ли мой PDF на сервер?",
    a: "Нет. Разделение выполняется целиком в вашем браузере, на вашем устройстве. Ничего не отправляется в Paul Digital или третьим лицам, а после закрытия страницы ничего не сохраняется.",
  },
  {
    q: "Почему мой PDF не принимается?",
    a: "Инструмент отклоняет файлы, которые не являются PDF, пустые или повреждённые файлы и PDF с защитой паролем. Лимиты — 100 МБ и 1000 страниц на файл. Чтобы разделить защищённый PDF, сначала снимите пароль в программе, в которой вы открываете файл.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "ru",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "ru",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Любая (в браузере)",
  browserRequirements: "Требуется JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="ru">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "Главная", href: "/" }, { label: h1 }]} breadcrumbLabel="Навигационная цепочка">
    <RazdelitPdf client:load />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>Как разделить PDF</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>Об этом инструменте</h2>
      <p>
        «Разделить PDF» создаёт новые PDF-файлы из выбранных страниц вашего документа. Можно собрать нужные страницы в один файл, разделить документ по диапазонам или сохранить каждую страницу отдельно.
      </p>
      <p>
        Страницы копируются в новые файлы без изменений и без повторного сжатия; исходный файл не затрагивается.
      </p>

      <h2>Ограничения инструмента</h2>
      <ul>
        <li><strong>Закладки и формы:</strong> закладки и интерактивные поля форм могут не сохраниться в новых файлах.</li>
        <li><strong>Цифровые подписи:</strong> подпись в извлечённых страницах перестаёт быть действительной.</li>
        <li><strong>Защищённые файлы:</strong> PDF с паролем отклоняются; инструмент не снимает защиту.</li>
        <li><strong>Количество файлов:</strong> за один раз можно создать не более 200 файлов.</li>
      </ul>

      <h2>Форматы и лимиты</h2>
      <p>
        <strong>Поддерживается:</strong> файлы .pdf без пароля, не более 100 МБ и 1000 страниц. Файлы с паролем, повреждённые, пустые и в других форматах отклоняются с пояснением причины.
      </p>

      <h2>Часто задаваемые вопросы</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>Другие инструменты</h2>
      <ul class="ic-links">
        <li><a href="/obedinit-pdf/">Объединить PDF: соедините несколько PDF в один файл</a></li>
        <li><a href="/szhat-pdf/">Сжать PDF: уменьшите размер PDF-файла</a></li>
        <li><a href="/pdf-v-word/">PDF в Word: преобразуйте PDF с текстом в документ DOCX</a></li>
        <li><a href="/word-v-pdf/">Word в PDF: преобразуйте документ .docx в PDF</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (на английском): все инструменты сайта</a></li>
      </ul>

      <h2>Конфиденциальность</h2>
      <p>
        Ваши файлы обрабатываются целиком в браузере, на вашем устройстве. Они не отправляются в Paul Digital и на какие-либо другие серверы, а после закрытия страницы ничего не сохраняется.
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import ConvertirePdfInWord from "../../components/tools/ConvertirePdfInWord";

const path = "/convertire-pdf-in-word/";
const title = "Convertire PDF in Word Gratis – PDF in DOCX | Paul Digital";
const description =
  "Converti gratis un PDF con testo in un documento Word (.docx) modificabile, direttamente nel browser e senza caricare il file su un server.";
const h1 = "Convertire PDF in Word";
const intro =
  "Trasforma un PDF con testo in un documento Word modificabile: gratis e direttamente nel tuo browser.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "Fai clic su «Seleziona un file PDF» oppure trascina il file nell'area indicata. Il PDF deve contenere testo selezionabile.",
  "La conversione parte subito: lo strumento legge il testo pagina per pagina e crea il documento Word.",
  "Al termine controlla il riepilogo (pagine lette, titoli, paragrafi) ed eventuali avvisi.",
  "Fai clic su «Scarica il file Word» per salvare il file .docx, che prende il nome del PDF originale."
];

const faqs = [
  {
    q: "Come si converte un PDF in Word?",
    a: "Seleziona il PDF in questo strumento: la conversione parte automaticamente. Al termine puoi scaricare il file .docx e aprirlo con Word o con un altro programma compatibile.",
  },
  {
    q: "La conversione da PDF a Word è gratuita?",
    a: "Sì. Lo strumento è gratuito, senza registrazione e senza installazione.",
  },
  {
    q: "Il mio PDF viene caricato su un server?",
    a: "No. La conversione avviene nel tuo browser, sul tuo dispositivo. Nulla viene inviato a Paul Digital o a terzi e, chiudendo la pagina, non viene conservato nulla.",
  },
  {
    q: "Posso convertire un PDF scansionato?",
    a: "No. Lo strumento non include il riconoscimento ottico dei caratteri (OCR) e legge solo il testo presente nel PDF. Se il documento è una scansione, viene rifiutato con un messaggio chiaro.",
  },
  {
    q: "Il documento Word avrà lo stesso aspetto del PDF?",
    a: "Non necessariamente. Il documento viene ricostruito a partire dal testo: tabelle, colonne, immagini e impaginazione complessa possono cambiare o non essere incluse. Controlla il risultato in Word.",
  },
  {
    q: "Perché il mio PDF viene rifiutato?",
    a: "Lo strumento rifiuta file che non sono PDF, file vuoti o danneggiati, PDF protetti da password, PDF senza testo selezionabile e PDF con più di 500 pagine. Per convertire un PDF protetto, rimuovi prima la password con l'applicazione che usi per aprirlo.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "it",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "it",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Tutti (browser)",
  browserRequirements: "È necessario JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="it">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "Home", href: "/" }, { label: h1 }]} breadcrumbLabel="Percorso di navigazione">
    <ConvertirePdfInWord client:load />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>Come convertire un PDF in Word</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>Informazioni su questo strumento</h2>
      <p>
        Convertire PDF in Word legge il testo di un PDF e con quello costruisce un documento .docx modificabile. Lo strumento usa la posizione dei singoli frammenti di testo nella pagina per riunire le righe in paragrafi e riconoscere i titoli; grassetto e corsivo vengono mantenuti quando sono riconosciuti con sicurezza. È utile per riutilizzare il testo di contratti, relazioni, articoli, curriculum o tesi.
      </p>

      <h2>Limiti di questo strumento</h2>
      <ul>
        <li><strong>Nessun OCR:</strong> funzionano solo i PDF con testo selezionabile. I PDF scansionati vengono riconosciuti e rifiutati con un messaggio esplicativo, invece di produrre un documento vuoto.</li>
        <li><strong>Impaginazione semplificata:</strong> tabelle, colonne, immagini, grafici, intestazioni, piè di pagina e interruzioni di pagina esatte non vengono necessariamente mantenuti. Il risultato è un testo continuo con titoli e paragrafi.</li>
        <li><strong>Font e colori:</strong> il documento usa i font predefiniti di Word. Vengono mantenuti solo grassetto e corsivo.</li>
        <li><strong>Alfabeti:</strong> i font che richiedono tabelle di caratteri speciali (cinese, giapponese, coreano…) potrebbero non essere estratti correttamente.</li>
        <li>Controlla sempre il risultato prima di usarlo per un documento importante.</li>
      </ul>

      <h2>Formati e limiti</h2>
      <p>
        <strong>Supportato:</strong> un file .pdf per volta, senza password, fino a 50 MB e 500 pagine. I file danneggiati, protetti da password o in altri formati vengono rifiutati con un messaggio che ne spiega il motivo.
      </p>

      <h2>Domande frequenti</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>Altri strumenti</h2>
      <ul class="ic-links">
        <li><a href="/convertire-word-in-pdf/">Convertire Word in PDF: trasforma un documento .docx in PDF</a></li>
        <li><a href="/comprimi-pdf/">Comprimi PDF: riduci le dimensioni di un file PDF</a></li>
        <li><a href="/unisci-pdf/">Unisci PDF: combina più file PDF in uno solo</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (in inglese): tutti gli strumenti del sito</a></li>
      </ul>

      <h2>Privacy</h2>
      <p>
        I tuoi file vengono elaborati interamente nel browser, sul tuo dispositivo. Non vengono inviati a Paul Digital né a
        nessun altro server e, chiudendo la pagina, non viene conservato nulla.
      </p>
    </div>
  </section>
</BaseLayout>

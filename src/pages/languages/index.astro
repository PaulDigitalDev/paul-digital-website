---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import { toolsByLanguage, englishToolNames } from "../../data/languageTools";

const path = "/languages/";
const title = "PDF Tools in Other Languages | Paul Digital";
const description =
  "Free PDF tools in Portuguese, Spanish, Indonesian, French, German, Italian, Russian, Arabic and Turkish: merge, split, compress and convert, in your browser.";
const groups = toolsByLanguage();
---

<BaseLayout title={title} description={description} canonicalUrl={path}>
  <ToolTop accent="pdf" h1="PDF Tools in Other Languages" intro="The same free PDF tools in nine languages. Each page is written in its own language and runs in your browser, so your files are never uploaded." crumbs={[{ label: "Home", href: "/" }, { label: "Web Tools", href: "/tools/" }, { label: "Other languages" }]} breadcrumbLabel="Breadcrumb" />
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      {
        groups.map(({ language, tools }) => (
          <>
            <h2 lang={language.code} dir={language.dir}>{language.name}</h2>
            <ul>
              {tools.map((t) => (
                <li>
                  <a href={`/${t.slug}/`} lang={t.lang} hreflang={t.lang} dir={language.dir}>{t.name}</a> <span>({englishToolNames[t.en]})</span>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p>Looking for the English versions? See <a href="/tools/">all web tools</a>.</p>
    </div>
  </section>
</BaseLayout>

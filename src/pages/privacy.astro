---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy — Paul Digital"
  description="Privacy information for the Paul Digital website and apps."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Legal information</span>
      <h1>Privacy</h1>
      <p>Privacy information should reflect the actual practices of the website and each app.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <p class="notice">This page does not describe specific data practices for the website or individual apps.</p>
      <h2>Information and data practices</h2>
      <p>Privacy information should explain what information is processed, why it is processed, where it is stored, how long it is retained and whether it is shared.</p>
      <h2>App-specific details</h2>
      <p>Each app has its own permissions, features, services and data practices. Information for one app may not apply to another.</p>
    </div>
  </section>
</BaseLayout>

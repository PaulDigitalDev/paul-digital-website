---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import Tool from "../../components/tools/DaghtPdf";

const path = "/daght-pdf/";
const title = "ضغط ملفات PDF مجانًا — تقليل حجم PDF | Paul Digital";
const description =
  "قلّل حجم ملف PDF مجانًا مع عرض الحجم الأصلي والحجم بعد الضغط ونسبة التخفيض الفعلية. تتم المعالجة داخل المتصفح دون رفع الملف إلى خادم.";
const h1 = "ضغط ملفات PDF";
const intro =
  "قلّل حجم ملف PDF مجانًا وداخل المتصفح مباشرة. ترى الحجم قبل الضغط وبعده ونسبة التخفيض الفعلية.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "اضغط «اختيار ملف PDF» أو اسحب الملف وأفلته في المنطقة المحددة. سيظهر عدد الصفحات وحجم الملف.",
  "اختر درجة الضغط. اختر «ضغط منخفض» إذا لم ترد تغيير الصور، أو درجة أعلى لتصغير صور JPEG.",
  "اضغط «ضغط الملف» وانتظر انتهاء المعالجة.",
  "قارن الحجم الأصلي بحجم الناتج ثم اضغط «تنزيل ملف PDF». إن لم يصغر الملف فلن يُعرض الناتج للتنزيل، وستظل قادرًا على تنزيل الأصل.",
];

const faqs = [
  {
    q: "كيف أضغط ملف PDF؟",
    a: "اختر الملف ودرجة الضغط ثم اضغط «ضغط الملف». تعرض الأداة الحجم الأصلي وحجم الناتج ونسبة التخفيض المقاسة فعليًا، ثم تتيح لك تنزيل الملف الجديد.",
  },
  {
    q: "ما الفرق بين درجات الضغط؟",
    a: "«ضغط منخفض» يعيد بناء الملف ويضغط بنيته الداخلية دون المساس بالصور. «ضغط متوسط» يقلّل صور JPEG بحد أقصى 2000 بكسل، و«ضغط قوي» يقلّلها بقوة أكبر وبحد أقصى 1400 بكسل. قد يظهر فقدان الجودة مع الدرجات الأعلى.",
  },
  {
    q: "كم سيصغر حجم الملف؟",
    a: "لا يمكن ضمان نسبة معينة، فالنتيجة تعتمد على محتوى الملف. الملفات المحسَّنة مسبقًا أو التي تتكون من نصوص فقط قد لا تصغر كثيرًا.",
  },
  {
    q: "ماذا لو أصبح الملف أكبر؟",
    a: "تعرض الأداة هذه الحالة بوضوح مع النسبة الفعلية ولا تقدّم الناتج الأكبر للتنزيل؛ الأفضل حينها الاحتفاظ بالملف الأصلي.",
  },
  {
    q: "هل تتأثر التوقيعات الرقمية؟",
    a: "نعم. إذا كان الملف يحتوي على توقيع رقمي فلن يكون التوقيع صالحًا في الملف المضغوط، لأن الملف يُعاد بناؤه. قد تتأثر أيضًا ميزات مثل بعض النماذج والعلامات.",
  },
  {
    q: "هل يتغير ملفي الأصلي؟",
    a: "لا. يبقى الملف الأصلي كما هو، ويُنشأ ملف جديد منفصل تنزّله بنفسك.",
  },
  {
    q: "هل يتم رفع ملفي إلى خادم؟",
    a: "لا. يتم الضغط كله داخل متصفحك وعلى جهازك. لا يُرسل أي شيء إلى Paul Digital أو إلى أطراف أخرى، ولا يُحفظ شيء بعد إغلاق الصفحة.",
  },
  {
    q: "لماذا لا يُقبل ملف PDF الخاص بي؟",
    a: "ترفض الأداة الملفات التي ليست PDF، والملفات الفارغة أو التالفة، وملفات PDF المحمية بكلمة مرور، والملفات التي يزيد حجمها على 100 ميغابايت.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "ar",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "الرئيسية", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "ar",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "أي نظام (داخل المتصفح)",
  browserRequirements: "يتطلب JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="ar" dir="rtl">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "الرئيسية", href: "/" }, { label: h1 }]} breadcrumbLabel="مسار التنقل">
    <Tool client:load />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>طريقة الاستخدام</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>عن هذه الأداة</h2>
      <p>
        تنشئ أداة «ضغط PDF» ملف PDF جديدًا أصغر حجمًا عندما يكون ذلك ممكنًا، بإعادة بناء بنية الملف وضغط محتواه، ويمكنها تصغير صور JPEG اختياريًا.
      </p>
      <p>
        تُقاس الأحجام فعليًا بعد المعالجة، وتُعرض كما هي حتى لو لم ينخفض الحجم. وتتحقق الأداة من إمكانية قراءة الملف الناتج قبل عرضه للتنزيل.
      </p>

      <h2>حدود الأداة</h2>
      <ul>
        <li><strong>النتيجة غير مضمونة:</strong> قد لا يصغر الملف إذا كان محسَّنًا مسبقًا أو يتكون في معظمه من محتوى لا يقبل المزيد من الضغط.</li>
        <li><strong>التوقيعات الرقمية:</strong> تفقد التوقيعات الرقمية صلاحيتها في الملف المضغوط.</li>
        <li><strong>الصور:</strong> تُعالَج صور JPEG فقط؛ وتبقى الصور بالصيغ الأخرى دون تغيير. والدرجات الأعلى تقلّل جودة الصور.</li>
        <li><strong>الملفات المحمية:</strong> تُرفض ملفات PDF المحمية بكلمة مرور؛ ولا تزيل الأداة الحماية.</li>
      </ul>

      <h2>الصيغ والحدود</h2>
      <p>
        <strong>المدعوم:</strong> ملفات .pdf بلا كلمة مرور بحد أقصى 100 ميغابايت. تُرفض الملفات المحمية أو التالفة أو الفارغة أو بصيغ أخرى مع توضيح السبب.
      </p>

      <h2>الأسئلة الشائعة</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>أدوات أخرى</h2>
      <ul class="ic-links">
        <li><a href="/damj-pdf/">دمج PDF: اجمع عدة ملفات PDF في ملف واحد</a></li>
        <li><a href="/taqsim-pdf/">تقسيم PDF: استخرج صفحات محددة من ملف PDF</a></li>
        <li><a href="/tahwil-pdf-ila-word/">تحويل PDF إلى Word: حوّل ملف PDF يحتوي على نص إلى مستند DOCX</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (بالإنجليزية): جميع أدوات الموقع</a></li>
      </ul>

      <h2>الخصوصية</h2>
      <p>
        تتم معالجة ملفاتك بالكامل داخل المتصفح وعلى جهازك. لا تُرسل إلى Paul Digital ولا إلى أي خادم آخر، ولا يُحفظ شيء بعد إغلاق الصفحة.
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import Tool from "../../components/tools/MergePdf";

const path = "/damj-pdf/";
const title = "دمج ملفات PDF مجانًا — ضم عدة ملفات PDF في ملف واحد | Paul Digital";
const description =
  "ادمج عدة ملفات PDF في ملف واحد مجانًا بالترتيب الذي تحدده، مع إمكانية إعادة الترتيب وإزالة الملفات. تتم المعالجة داخل المتصفح دون رفع الملفات إلى خادم.";
const h1 = "دمج ملفات PDF";
const intro =
  "اجمع عدة ملفات PDF في ملف واحد بالترتيب الذي تريده، مجانًا وداخل المتصفح دون رفع الملفات إلى خادم.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "اضغط «إضافة ملفات» أو اسحب ملفات PDF وأفلتها في المنطقة المحددة. أضف ملفين على الأقل.",
  "رتّب الملفات بالأسهم، وأزل أي ملف لا تريده بزر «إزالة الملف».",
  "اضغط «دمج ملفات PDF». ستُدمج الصفحات بحسب ترتيب القائمة.",
  "اضغط «تنزيل ملف PDF» لحفظ الملف المدموج.",
];

const faqs = [
  {
    q: "كيف أدمج ملفات PDF؟",
    a: "أضف ملفَّي PDF أو أكثر، ورتّبها كما تريد، ثم اضغط «دمج ملفات PDF». تُنشأ نسخة جديدة تحتوي صفحات الملفات بالترتيب نفسه.",
  },
  {
    q: "هل أستطيع تغيير ترتيب الملفات؟",
    a: "نعم. استخدم أسهم الأعلى والأسفل بجانب كل ملف لتغيير موضعه، أو أزل الملف من القائمة.",
  },
  {
    q: "هل تتجاهل الأداة الملفات التي تفشل معالجتها؟",
    a: "لا. إذا كان أحد الملفات تالفًا أو محميًا بكلمة مرور أو ليس PDF فلا يُضاف إلى القائمة وتظهر لك رسالة توضح السبب، فلا يُدمج شيء دون علمك.",
  },
  {
    q: "هل يتم رفع ملفاتي إلى خادم؟",
    a: "لا. يتم الدمج كله داخل متصفحك وعلى جهازك. لا يُرسل أي شيء إلى Paul Digital أو إلى أطراف أخرى، ولا يُحفظ شيء بعد إغلاق الصفحة.",
  },
  {
    q: "هل تتغير ملفاتي الأصلية؟",
    a: "لا. تبقى الملفات الأصلية كما هي، ويُنشأ ملف جديد منفصل.",
  },
  {
    q: "ما حدود الأداة؟",
    a: "حتى 30 ملفًا في العملية الواحدة، وبحد أقصى 100 ميغابايت لكل ملف و300 ميغابايت للمجموع.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "ar",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "الرئيسية", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "ar",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "أي نظام (داخل المتصفح)",
  browserRequirements: "يتطلب JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="ar" dir="rtl">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "الرئيسية", href: "/" }, { label: h1 }]} breadcrumbLabel="مسار التنقل">
    <Tool client:load locale="ar" />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>طريقة الاستخدام</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>عن هذه الأداة</h2>
      <p>
        تنسخ أداة «دمج PDF» صفحات كل ملف إلى مستند جديد بالترتيب الذي تراه في القائمة، دون إعادة ضغط الصفحات.
      </p>
      <p>
        يُنشأ الملف المدموج على جهازك، ويمكنك تنزيله مباشرة بعد اكتمال الدمج.
      </p>

      <h2>حدود الأداة</h2>
      <ul>
        <li><strong>الإشارات المرجعية والنماذج:</strong> قد لا تُحفظ الإشارات المرجعية وحقول النماذج التفاعلية في الملف المدموج.</li>
        <li><strong>التوقيعات الرقمية:</strong> تفقد التوقيعات الرقمية صلاحيتها في الملف المدموج.</li>
        <li><strong>الملفات المحمية:</strong> تُرفض ملفات PDF المحمية بكلمة مرور؛ ولا تزيل الأداة الحماية.</li>
        <li><strong>عدد الملفات:</strong> الحد الأقصى 30 ملفًا في المرة الواحدة.</li>
      </ul>

      <h2>الصيغ والحدود</h2>
      <p>
        <strong>المدعوم:</strong> ملفات .pdf بلا كلمة مرور، بحد أقصى 100 ميغابايت لكل ملف و300 ميغابايت للمجموع. تُرفض الملفات المحمية أو التالفة أو الفارغة أو بصيغ أخرى مع توضيح السبب.
      </p>

      <h2>الأسئلة الشائعة</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>أدوات أخرى</h2>
      <ul class="ic-links">
        <li><a href="/taqsim-pdf/">تقسيم PDF: استخرج صفحات محددة من ملف PDF</a></li>
        <li><a href="/daght-pdf/">ضغط PDF: قلّل حجم ملف PDF</a></li>
        <li><a href="/tahwil-pdf-ila-word/">تحويل PDF إلى Word: حوّل ملف PDF يحتوي على نص إلى مستند DOCX</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (بالإنجليزية): جميع أدوات الموقع</a></li>
      </ul>

      <h2>الخصوصية</h2>
      <p>
        تتم معالجة ملفاتك بالكامل داخل المتصفح وعلى جهازك. لا تُرسل إلى Paul Digital ولا إلى أي خادم آخر، ولا يُحفظ شيء بعد إغلاق الصفحة.
      </p>
    </div>
  </section>
</BaseLayout>

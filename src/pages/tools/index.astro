---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import { imageSizeRoutes } from "../../data/imageSizeRoutes";
import { jpgToPdfRoutes } from "../../data/jpgToPdfRoutes";

const tools = [
  {
    id: "image-compressor",
    name: "Image Compressor",
    description: "Compress or resize an image toward a target size, right in your browser.",
    code: "IMG",
    href: "/image-compressor/",
  },
  {
    id: "jpg-to-pdf",
    name: "JPG to PDF",
    description: "Combine JPG images into a PDF in your browser and check the real file size against a target.",
    code: "PDF",
    href: "/jpg-to-pdf/",
  },
];
---

<BaseLayout
  title="Web Tools — Paul Digital"
  description="Paul Digital web tools: reduce or resize images toward a target file size, and convert JPG images to PDF, all in your browser."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Useful tools, right in your browser</span>
      <h1>Web tools</h1>
      <p>Practical browser-based tools for everyday tasks.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div class="card-grid">
        {tools.map((tool) => <ToolCard {...tool} />)}
      </div>
    </div>
  </section>
  <section class="content-section" style="padding-top: 0" aria-labelledby="image-sizes-heading">
    <div class="container">
      <h2 id="image-sizes-heading">Image Compressor by target size</h2>
      <p style="color: var(--muted)">
        Pick a size to open the compressor with that target already set. You can edit it on the page. Not sure which size you need?
        Start with the <a href="/compress-image-to-100kb/">main Image Compressor</a>.
      </p>
      <ul class="ic-links">
        {imageSizeRoutes.map((route) => <li><a href={`/${route.slug}/`}>{route.h1}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="content-section" style="padding-top: 0" aria-labelledby="jpg-to-pdf-heading">
    <div class="container">
      <h2 id="jpg-to-pdf-heading">JPG to PDF by target size</h2>
      <p style="color: var(--muted)">
        Convert one or more JPG images into a single PDF with a size goal already filled in. You can edit the target on the page,
        and the actual PDF size is always measured and reported.
      </p>
      <ul class="ic-links">
        {jpgToPdfRoutes.map((route) => <li><a href={`/${route.slug}/`}>{route.h1}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

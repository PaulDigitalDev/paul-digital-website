---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolList from "../../components/ToolList.astro";
import { categories, toolsInCategory, type ToolCategory } from "../../data/toolRegistry";

export function getStaticPaths() {
  return categories
    .filter((category) => category.route && toolsInCategory(category.id).length > 0)
    .map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props as { category: ToolCategory };
const tools = toolsInCategory(category.id);
const path = category.route!;
const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const copy: Record<string, { description: string; about: string[]; crossLinks: { href: string; label: string }[] }> = {
  image: {
    description:
      "Compress images to a target file size, resize, crop and rotate them, view and remove metadata, convert JPG, PNG, WebP, AVIF and HEIC, make icons, and prepare photos for passports, signatures, Instagram, WhatsApp and YouTube. Everything runs in your browser.",
    about: [
      "These tools read your image with your browser, process it on your device and give you a file to download. Nothing is sent to Paul Digital or any other server.",
      "Quality settings and results depend on the original image and the browser you use. Tools that aim for a size, such as the Image Compressor, treat it as a goal and always report the actual size of the file they produce.",
    ],
    crossLinks: [
      { href: "/jpg-to-pdf/", label: "Put JPG images into a PDF" },
      { href: "/image-to-word/", label: "Put images into a Word document" },
    ],
  },
  calculators: {
    description:
      "Free finance calculators: time value of money, future value, compound interest, salary increase, loan payments and return on investment. Results update as you type, and nothing you enter leaves your device.",
    about: [
      "Each calculator uses a standard formula and shows its working, with examples that are computed by the same maths. Enter your own numbers and the result updates straight away.",
      "Results are estimates from the numbers you enter. They are not financial, tax or legal advice, and they are not a quote from a lender or bank. Real returns and interest rates change, and fees and tax are not included.",
    ],
    crossLinks: [
      { href: "/tvm-calculator/", label: "Solve any time-value-of-money problem" },
      { href: "/loan-calculator/", label: "Work out a loan payment" },
    ],
  },
  calendars: {
    description:
      "বাংলা তারিখ কনভার্টার, আজকের বাংলা তারিখ ও বাংলা ক্যালেন্ডার, বাংলাদেশ ও পশ্চিমবঙ্গ দুই ক্যালেন্ডারে। সব হিসাব আপনার ব্রাউজারেই হয়। Bangla date converter, today's Bangla date and Bangla calendar for Bangladesh and West Bengal.",
    about: [
      "বাংলাদেশ ও পশ্চিমবঙ্গের বাংলা পঞ্জিকার নিয়ম আলাদা। বাংলাদেশে মাস শুরুর ইংরেজি তারিখ নির্দিষ্ট, আর পশ্চিমবঙ্গে সূর্যসিদ্ধান্ত অনুযায়ী হিসাব হয়, তাই দুটিই আলাদাভাবে দেওয়া আছে।",
      "এখানকার তারিখ গণনাভিত্তিক অনুমান। সরকারি, আইনি বা ধর্মীয় কাজের জন্য আপনার নির্ভরযোগ্য পঞ্জিকা দেখে নিন।",
      "এই পাতাগুলিতে বাংলা তারিখ, বাংলা মাস ও ঋতু এবং বাংলা সন ও ইংরেজি তারিখের পরিবর্তন সহজে দেখা যায়। বাংলাদেশ ও পশ্চিমবঙ্গ—দুই নিয়মেই আলাদা ক্যালেন্ডার আছে।",
      "কোনো তারিখ লিখলে সেটির বাংলা তারিখ ও বার দেখুন, অথবা আজকের বাংলা তারিখ এক নজরে জেনে নিন। নববর্ষ, ঋতু ও মাসের নাম একসঙ্গে দেখানো হয়।",
      "সব হিসাব আপনার ব্রাউজারে হয়, কোনো তথ্য কোথাও পাঠানো হয় না। উৎসব বা ধর্মীয় কাজের তারিখের জন্য স্থানীয় পঞ্জিকার সঙ্গে মিলিয়ে নিন।",
    ],
    crossLinks: [
      { href: "/bangla-date-converter/", label: "বাংলা তারিখ কনভার্টার" },
      { href: "/bangla-date-today/", label: "আজকের বাংলা তারিখ" },
    ],
  },
  numbers: {
    description:
      "Write numbers and money in words: English with Indian or international grouping, Hindi, Bangla, rupees, taka, dollars, pounds and euros, a cheque amount writer, a bulk converter and more languages. Everything runs in your browser.",
    about: [
      "Each page turns the figures you type into words as you type. Indian pages use lakh and crore, and international pages use million and billion, so choose the one your document uses.",
      "The words follow standard writing rules, but you are responsible for what you write. Check cheques, legal papers and formal documents before you use them, and ask a fluent speaker to check wording in other languages.",
    ],
    crossLinks: [
      { href: "/number-to-words/", label: "Convert any number to words" },
      { href: "/cheque-amount-in-words/", label: "Write a cheque amount in words" },
    ],
  },
  land: {
    description:
      "Convert land area between acres, hectares, square feet, square metres and the traditional units used in Bangladesh, West Bengal, Nepal and India: decimal, katha, bigha, gunta, kanal, ropani and more. Everything runs in your browser.",
    about: [
      "Every unit is converted through square feet, so any unit can be turned into any other. Katha, bigha and similar units use their standard values and are marked by region where they differ.",
      "Traditional land units can differ between districts and old records. For a sale, deed or legal record, use the area on the official document and check it with the local land office or a surveyor.",
    ],
    crossLinks: [
      { href: "/bangladesh-land-converter/", label: "Bangladesh land converter" },
      { href: "/nepal-land-converter/", label: "Nepal land converter" },
    ],
  },
  color: {
    description:
      "Convert colors between HEX, RGB and HSL, and pick a color to get its codes. Everything runs in your browser.",
    about: [
      "HEX, RGB and HSL are different ways to write the same color, so converting between them does not change how it looks.",
      "Colors can look slightly different on different screens, so check important brand colors on the devices your audience uses.",
      "Use the converter when a design file gives a color in one format and your code needs another. Web pages and stylesheets accept HEX, RGB and HSL, and design tools often show only one of them.",
      "HSL is the easiest format to adjust by hand. Change only the lightness to make a shade lighter or darker, or lower the saturation to mute a color. Convert back to HEX when you need a code to paste into a stylesheet or an app.",
      "Everything here runs in your browser, so the colors you type are never sent anywhere. The pages cover HEX to RGB, RGB to HEX and HEX to HSL, and each one also shows the other formats.",
    ],
    crossLinks: [
      { href: "/hex-to-rgb/", label: "HEX to RGB" },
      { href: "/rgb-to-hex/", label: "RGB to HEX" },
    ],
  },
  math: {
    description:
      "Convert numbers between binary, decimal, octal and hexadecimal, and between numbers and Roman numerals. Everything runs in your browser.",
    about: [
      "Number base conversions are exact, and very long numbers are handled without rounding. Binary and hex results are grouped in fours to make them easier to read.",
      "Roman numerals follow the standard form and cover 1 to 3999.",
      "Binary, octal, decimal and hexadecimal are the number bases used most in computing. Binary uses only 0 and 1 and is how computers store data, hexadecimal is a shorter way to write binary, and octal appears in Unix file permissions.",
      "Every base conversion here is exact, even for very long numbers, because it uses whole-number arithmetic rather than rounding. Each page also shows the number in all four bases so you can compare them.",
      "The Roman numeral converter works both ways for 1 to 3999 and rejects forms that are not standard, such as IIII, so you can use it to check homework or a year on a monument.",
    ],
    crossLinks: [
      { href: "/binary-to-decimal/", label: "Binary to decimal" },
      { href: "/hex-to-decimal/", label: "Hex to decimal" },
    ],
  },
  units: {
    description:
      "Convert length, weight, volume and temperature: centimeters to inches, kilograms to pounds, miles to kilometers, Celsius to Fahrenheit, liters to gallons and more. Everything runs in your browser.",
    about: [
      "Each converter uses exact or internationally agreed conversion factors, such as 1 inch = 25.4 mm and 1 pound = 453.59237 g. Results are rounded for display only.",
      "Where countries use different versions of a unit, such as the US and UK gallon or fluid ounce, the page says which one it uses.",
    ],
    crossLinks: [
      { href: "/cm-to-inches/", label: "CM to inches" },
      { href: "/kg-to-lbs/", label: "KG to pounds" },
    ],
  },
  weight: {
    description:
      "Convert gold and silver weight between vori, tola, ana, roti, masha, gram, kilogram and ounce, in English or Bangla, and work out the price of gold from its weight. Everything runs in your browser.",
    about: [
      "One vori (tola) is 11.664 grams, split into 16 ana or 96 roti. The weight does not depend on the carat; only the price does.",
      "Jewellers may round slightly. For a purchase, rely on the weight on the shop's scale and the bill.",
      "Gold and silver in Bangladesh, India and Pakistan are weighed in vori (tola), ana and roti, while shops and the world market quote grams and troy ounces. These pages convert between them and show the same weight in every unit.",
      "The weight of a vori does not change with carat, so 22K and 18K gold of one vori weigh the same. Only the price differs. Use the gold price calculator to turn a weight and a day's rate into an estimated price with a making charge.",
      "Always rely on the weight shown on the jeweller's scale and the bill. Small differences in rounding between shops are normal.",
    ],
    crossLinks: [
      { href: "/vori-to-gram/", label: "Vori to gram" },
      { href: "/gold-price-calculator/", label: "Gold price calculator" },
    ],
  },
  text: {
    description:
      "Count characters, words, sentences and reading time, change text case, remove line breaks, extra spaces and duplicate lines, repeat text, check SMS length and count Bangla words. Everything runs in your browser.",
    about: [
      "These tools work on the text you type or paste, right in your browser. Your text is never sent to Paul Digital or any other server.",
      "Counts follow simple, stated rules, such as a word being anything between spaces. Platforms and forms can count differently, so check any limit that matters against the platform's own counter.",
    ],
    crossLinks: [
      { href: "/character-counter/", label: "Count characters and check limits" },
      { href: "/case-converter/", label: "Change text case" },
    ],
  },
  document: {
    description:
      "Put images into a Word document or pull printed English text out of JPG and PNG pictures with browser-based OCR. Processing happens on your device.",
    about: [
      "Image to Word places your pictures into a .docx file; it does not turn them into editable text. For text, the OCR tools read printed English and may make mistakes, so check the result.",
      "OCR downloads its engine and English language data (about 8 MB) the first time it runs. They are served from this site, not a third-party network.",
      "These tools help with documents made from pictures. Image to Word puts your photos or scans into a Word file, one image per page, so you can print or share them as a document.",
      "The OCR tools read printed English text from JPG and PNG pictures, so you can copy words out of a screenshot or a scanned page. Accuracy depends on how clear the picture is, so check the result before you rely on it.",
      "Your files stay on your device. The pictures are processed in your browser, and the OCR engine is served from this site, so nothing you open is uploaded to a server.",
    ],
    crossLinks: [
      { href: "/jpg-to-pdf/", label: "Combine JPG images into a PDF" },
      { href: "/image-compressor/", label: "Reduce an image before you use it" },
    ],
  },
};
const info = copy[category.id];
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: "Web tools", item: site("/tools/") },
    { "@type": "ListItem", position: 3, name: category.name, item: site(path) },
  ],
};
---

<BaseLayout title={`${category.name} — Free Online, In Your Browser | Paul Digital`} description={info.description} canonicalUrl={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(schema)} />
  </Fragment>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/tools/">Web tools</a></li>
          <li aria-current="page">{category.name}</li>
        </ol>
      </nav>
      <h1>{category.name}</h1>
      <p>{category.summary} {tools.length} tools, all running in your browser.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <ToolList tools={tools} />
      <div class="prose target-about">
        {info.about.map((text) => <p>{text}</p>)}
        <h2>Related workflows</h2>
        <ul>
          {info.crossLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <p><a href="/tools/">Browse all web tools</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

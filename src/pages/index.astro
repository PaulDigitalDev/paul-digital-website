---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import ToolCard from "../components/ToolCard.astro";
import { publishedApps } from "../data/apps";

const tools = [
  { id: "image-compressor", name: "Image Compressor", description: "Compress or resize an image toward a target size, right in your browser.", code: "IMG", href: "/compress-image-to-100kb/" },
];
---

<BaseLayout
  title="Paul Digital — Simple Utilities. Powerful Results."
  description="Paul Digital creates lightweight Android apps and practical digital tools for everyday tasks."
>
  <div class="homepage">
    <section class="hero home-hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <h1>Paul <span class="brand-accent">Digital</span></h1>
          <h2>Simple Utilities. Powerful Results.</h2>
          <p>Paul Digital creates lightweight Android apps and practical digital tools for everyday tasks.</p>
          <div class="actions">
            <a class="button button-primary" href="/apps/">Apps <span aria-hidden="true">→</span></a>
            <a class="button button-soft" href="/tools/">Web Tools <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section home-section" aria-labelledby="android-apps">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2 id="android-apps" class="section-title">Android Apps</h2>
            <p>Lightweight Android utilities for everyday tasks.</p>
          </div>
          <a class="section-link" href="/apps/">View all apps <span aria-hidden="true">→</span></a>
        </div>
        <div class="card-grid app-grid app-grid-published">
          {publishedApps.map((app) => <AppCard app={app} />)}
        </div>
      </div>
    </section>

    <section class="section home-section tools-section" aria-labelledby="web-tools">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2 id="web-tools" class="section-title">Web Tools</h2>
            <p>Practical browser-based tools for everyday tasks.</p>
          </div>
          <a class="section-link" href="/tools/">View all tools <span aria-hidden="true">→</span></a>
        </div>
        <div class="card-grid tool-grid">
          {tools.map((tool) => <ToolCard {...tool} />)}
        </div>
      </div>
    </section>

    <section class="section home-section guides-section" aria-labelledby="featured-guide">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2 id="featured-guide" class="section-title">Guides</h2>
            <p>Short, practical reading for everyday digital tasks.</p>
          </div>
          <a class="section-link" href="/guides/">View all guides <span aria-hidden="true">→</span></a>
        </div>
        <article class="guide-feature">
          <span class="guide-icon" aria-hidden="true">PDF</span>
          <div>
            <h3>Preparing text before creating a PDF</h3>
            <p>A few simple checks for clearer documents.</p>
          </div>
          <a class="guide-arrow" href="/guides/preparing-text-for-a-pdf/" aria-label="Read Preparing text before creating a PDF">
            Read guide <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

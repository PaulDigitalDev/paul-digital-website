---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Licenses — Paul Digital"
  description="Information about open-source software licenses used by Paul Digital."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Open source</span>
      <h1>Licenses</h1>
      <p>A place for clear attribution of open-source software used by Paul Digital projects.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <h2>Third-party software</h2>
      <p>Open-source notices identify applicable components, versions, copyright notices, licenses and license texts or links.</p>
      <h2>Paul Digital content</h2>
      <p>Copyright and reuse terms depend on the applicable Paul Digital work.</p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Paul Digital"
  description="Contact Paul Digital for app support, bug reports, feature feedback, privacy and legal questions, or general inquiries."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Get in touch</h1>
      <p>For support and inquiries, contact Paul Digital by email.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <p>
        Contact <a href="mailto:askpaulonline@gmail.com">askpaulonline@gmail.com</a> for app
        support, bug reports, feature feedback, privacy questions, legal or Terms questions, and
        business or general inquiries.
      </p>
      <h2>App support</h2>
      <p>
        To help us understand an app issue, include the app name, device model, Android version,
        a description of the problem, and the steps needed to reproduce it, if applicable.
      </p>
      <p>
        <a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Use</a> ·
        <a href="/apps/">Paul Digital apps</a>
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import SzhatPdf from "../../components/tools/SzhatPdf";

const path = "/szhat-pdf/";
const title = "Сжать PDF онлайн бесплатно — Уменьшить размер PDF | Paul Digital";
const description =
  "Сожмите PDF бесплатно в браузере: три степени сжатия, реальный размер до и после и никакой загрузки на сервер. Результат зависит от содержимого файла.";
const h1 = "Сжать PDF";
const intro =
  "Уменьшите размер PDF, чтобы проще отправить или загрузить файл: бесплатно и прямо в браузере.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "Нажмите «Выберите PDF-файл» или перетащите файл в отмеченную область. Будет показан исходный размер.",
  "Выберите степень сжатия: низкое, среднее или сильное. При желании можно удалить метаданные документа.",
  "Нажмите «Сжать файл» и дождитесь окончания обработки.",
  "Сравните исходный и итоговый размер и скачайте сжатый PDF, если он получился меньше.",
];

const faqs = [
  {
    q: "Как уменьшить размер PDF?",
    a: "Выберите PDF, укажите степень сжатия и нажмите «Сжать файл». Вы увидите реальный размер до и после и сможете скачать результат, если он меньше исходного.",
  },
  {
    q: "Это бесплатно?",
    a: "Да. Инструмент бесплатный, не требует регистрации и установки программ.",
  },
  {
    q: "Загружается ли мой PDF на сервер?",
    a: "Нет. Сжатие выполняется в вашем браузере, на вашем устройстве. Ничего не отправляется в Paul Digital или третьим лицам, а после закрытия страницы ничего не сохраняется.",
  },
  {
    q: "На сколько уменьшится файл?",
    a: "Это зависит от содержимого. Если в PDF много JPEG-изображений, файл может уменьшиться заметно; у текстовых или уже оптимизированных документов выигрыш обычно небольшой. Инструмент показывает реальный процент и не гарантирует конкретный итоговый размер.",
  },
  {
    q: "Чем отличаются степени сжатия?",
    a: "При низком сжатии перестраивается структура файла, а изображения не изменяются. При среднем и сильном сжатии дополнительно уменьшаются JPEG-изображения (сильнее — при более высокой степени), что может снизить их качество. Изображения других форматов, шрифты и векторная графика не пережимаются.",
  },
  {
    q: "Что будет, если файл не уменьшился?",
    a: "Тогда созданный файл не предлагается для скачивания. Инструмент сообщит об этом, и вы сможете оставить исходный файл или попробовать другую степень сжатия.",
  },
  {
    q: "Сохранится ли цифровая подпись?",
    a: "Нет. Если изменить подписанный PDF, подпись в новом файле перестанет быть действительной. Для подписанных документов используйте исходный файл.",
  },
  {
    q: "Почему мой PDF не принимается?",
    a: "Инструмент отклоняет файлы, которые не являются PDF, пустые или повреждённые файлы и PDF с защитой паролем. Чтобы сжать защищённый PDF, сначала снимите пароль в программе, в которой вы открываете файл.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "ru",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "ru",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Любая (в браузере)",
  browserRequirements: "Требуется JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="ru">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "Главная", href: "/" }, { label: h1 }]} breadcrumbLabel="Навигационная цепочка">
    <SzhatPdf client:load />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>Как сжать PDF</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>Об этом инструменте</h2>
      <p>
        «Сжать PDF» создаёт новую, более компактную версию файла: перестраивает его структуру, сжимает содержимое и, на среднем и сильном уровне, уменьшает JPEG-изображения. Исходный файл не изменяется.
      </p>
      <p>
        Результат всегда считается по фактически созданному файлу. Если он не меньше исходного, инструмент честно об этом сообщит и не предложит его скачать.
      </p>

      <h2>Ограничения инструмента</h2>
      <ul>
        <li><strong>Только JPEG:</strong> уменьшаются JPEG-изображения. Изображения других форматов, шрифты и векторная графика не пережимаются, поэтому для текстовых документов эффект обычно небольшой.</li>
        <li><strong>Потеря качества:</strong> при среднем и сильном сжатии качество JPEG-изображений снижается; на фотографиях и сканах это может быть заметно.</li>
        <li><strong>Цифровые подписи:</strong> в сжатом файле подпись перестаёт быть действительной.</li>
        <li><strong>Защищённые файлы:</strong> PDF с паролем отклоняются; инструмент не снимает защиту.</li>
        <li><strong>Метаданные:</strong> их удаление — отдельная необязательная опция, которая сама по себе почти не уменьшает размер.</li>
      </ul>

      <h2>Форматы и лимиты</h2>
      <p>
        <strong>Поддерживается:</strong> файлы .pdf без пароля размером до 100 МБ. Файлы с паролем, повреждённые, пустые и в других форматах отклоняются с пояснением причины.
      </p>

      <h2>Часто задаваемые вопросы</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>Другие инструменты</h2>
      <ul class="ic-links">
        <li><a href="/obedinit-pdf/">Объединить PDF: соедините несколько PDF в один файл</a></li>
        <li><a href="/razdelit-pdf/">Разделить PDF: извлеките нужные страницы</a></li>
        <li><a href="/pdf-v-word/">PDF в Word: преобразуйте PDF с текстом в документ DOCX</a></li>
        <li><a href="/word-v-pdf/">Word в PDF: преобразуйте документ .docx в PDF</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (на английском): все инструменты сайта</a></li>
      </ul>

      <h2>Конфиденциальность</h2>
      <p>
        Ваши файлы обрабатываются целиком в браузере, на вашем устройстве. Они не отправляются в Paul Digital и на какие-либо другие серверы, а после закрытия страницы ничего не сохраняется.
      </p>
    </div>
  </section>
</BaseLayout>

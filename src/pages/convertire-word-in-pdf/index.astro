---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import ConvertireWordInPdf from "../../components/tools/ConvertireWordInPdf";

const path = "/convertire-word-in-pdf/";
const title = "Convertire Word in PDF Gratis – DOCX in PDF | Paul Digital";
const description =
  "Converti gratis un documento Word (.docx) in PDF direttamente nel browser, senza caricare il file su un server. Testo, elenchi, tabelle e immagini di base.";
const h1 = "Convertire Word in PDF";
const intro =
  "Trasforma un documento Word (.docx) in PDF: gratis e direttamente nel tuo browser.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "Fai clic su «Seleziona un file Word» oppure trascina il file .docx nell'area indicata.",
  "La conversione parte subito: lo strumento legge il documento e lo impagina in un PDF.",
  "Al termine controlla il riepilogo (pagine, tabelle, immagini) ed eventuali avvisi su elementi non mantenuti.",
  "Fai clic su «Scarica il PDF» per salvare il file, che prende il nome del documento originale."
];

const faqs = [
  {
    q: "Come si converte un file Word in PDF?",
    a: "Seleziona il file .docx in questo strumento: la conversione parte automaticamente. Al termine puoi scaricare il PDF.",
  },
  {
    q: "La conversione da Word a PDF è gratuita?",
    a: "Sì. Lo strumento è gratuito, senza registrazione e senza installazione.",
  },
  {
    q: "Il mio documento viene caricato su un server?",
    a: "No. La conversione avviene nel tuo browser, sul tuo dispositivo. Nulla viene inviato a Paul Digital o a terzi e, chiudendo la pagina, non viene conservato nulla.",
  },
  {
    q: "Il PDF sarà identico al documento Word?",
    a: "Non esattamente. Testo, formattazione di base, elenchi, tabelle e immagini nel flusso del testo vengono mantenuti, ma il PDF usa font standard e l'impaginazione può differire da quella di Word.",
  },
  {
    q: "Posso convertire un file .doc?",
    a: "No. Sono supportati solo i file in formato .docx. Apri il file in Word e salvalo come .docx.",
  },
  {
    q: "Perché il mio file viene rifiutato?",
    a: "Lo strumento rifiuta file che non sono .docx validi, file vuoti, danneggiati o protetti da password, documenti senza testo né immagini convertibili e documenti oltre 300 pagine.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "it",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "it",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Tutti (browser)",
  browserRequirements: "È necessario JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="it">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "Home", href: "/" }, { label: h1 }]} breadcrumbLabel="Percorso di navigazione">
    <ConvertireWordInPdf client:load />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>Come convertire un documento Word in PDF</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>Informazioni su questo strumento</h2>
      <p>
        Convertire Word in PDF legge un documento .docx direttamente nel browser e ne crea un PDF. Sono supportati paragrafi, titoli, grassetto e corsivo, elenchi, tabelle, immagini nel flusso del testo e interruzioni di pagina. Nessun file viene caricato su un server.
      </p>
      <p>
        La conversione è un'approssimazione dell'impaginazione di Word e non una sostituzione esatta: il PDF usa font standard al posto di quelli del documento, quindi le interruzioni di riga e di pagina possono differire.
      </p>

      <h2>Limiti di questo strumento</h2>
      <ul>
        <li><strong>Solo .docx:</strong> i vecchi file .doc e i documenti protetti da password vengono rifiutati. Salvali in Word come .docx.</li>
        <li><strong>Non mantenuti:</strong> intestazioni e piè di pagina, numeri di pagina, note a piè di pagina e di chiusura, caselle di testo, forme, grafici, formule e oggetti incorporati. Se vengono rilevati, lo strumento lo segnala dopo la conversione.</li>
        <li><strong>Font:</strong> vengono usati i font standard del formato PDF. I caratteri che non esistono in quei font (ad esempio emoji o alfabeti non latini) vengono sostituiti con «?».</li>
        <li><strong>Immagini:</strong> le immagini con posizione libera vengono inserite nel flusso del testo, quindi la loro posizione può cambiare.</li>
        <li>Controlla sempre il PDF prima di usarlo per un documento importante.</li>
      </ul>

      <h2>Formati e limiti</h2>
      <p>
        <strong>Supportato:</strong> un file .docx per volta, senza password, fino a 25 MB e 300 pagine. I file danneggiati, protetti da password o in altri formati vengono rifiutati con un messaggio che ne spiega il motivo.
      </p>

      <h2>Domande frequenti</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>Altri strumenti</h2>
      <ul class="ic-links">
        <li><a href="/convertire-pdf-in-word/">Convertire PDF in Word: trasforma un PDF con testo in un documento modificabile</a></li>
        <li><a href="/comprimi-pdf/">Comprimi PDF: riduci le dimensioni di un file PDF</a></li>
        <li><a href="/unisci-pdf/">Unisci PDF: combina più file PDF in uno solo</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (in inglese): tutti gli strumenti del sito</a></li>
      </ul>

      <h2>Privacy</h2>
      <p>
        I tuoi file vengono elaborati interamente nel browser, sul tuo dispositivo. Non vengono inviati a Paul Digital né a
        nessun altro server e, chiudendo la pagina, non viene conservato nulla.
      </p>
    </div>
  </section>
</BaseLayout>

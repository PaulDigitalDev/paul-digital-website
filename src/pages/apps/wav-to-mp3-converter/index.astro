---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AppDetail from "../../../components/AppDetail.astro";
import { getAppBySlug } from "../../../data/apps";

const app = getAppBySlug("wav-to-mp3-converter");
---

<BaseLayout
  title={`${app.name} — Paul Digital`}
  description={`${app.description} View WAV to MP3 Converter on Google Play.`}
>
  <AppDetail app={app} />
</BaseLayout>

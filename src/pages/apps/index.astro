---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppCard from "../../components/AppCard.astro";
import { publishedApps } from "../../data/apps";
---

<BaseLayout
  title="Apps — Paul Digital"
  description="Explore Paul Digital apps, including Image to PDF Converter Offline and WAV to MP3 Converter."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Paul Digital apps</span>
      <h1>Apps</h1>
      <p>Explore Paul Digital apps available on Google Play.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <h2 class="section-title">Published Apps</h2>
      <div class="card-grid app-grid">
        {publishedApps.map((app) => <AppCard app={app} />)}
      </div>
    </div>
  </section>
</BaseLayout>

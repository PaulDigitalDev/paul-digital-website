---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTop from "../../components/ToolTop.astro";
import MergePdf from "../../components/tools/MergePdf";

const path = "/obedinit-pdf/";
const title = "Объединить PDF онлайн бесплатно — Соединить PDF-файлы | Paul Digital";
const description =
  "Объедините несколько PDF-файлов в один бесплатно: задайте порядок, удалите лишние файлы и скачайте результат. Всё происходит в браузере, без загрузки на сервер.";
const h1 = "Объединить PDF";
const intro =
  "Соедините несколько PDF-файлов в один документ: быстро, бесплатно и прямо в браузере.";

const site = (p: string) => new URL(p, Astro.site).href;
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const steps = [
  "Нажмите «Добавить файлы» или перетащите PDF-файлы в отмеченную область. Можно выбрать сразу несколько файлов.",
  "Проверьте список: у каждого PDF указаны число страниц и размер. Стрелками меняйте порядок, а кнопкой «Удалить файл» убирайте лишнее.",
  "Нажмите «Объединить PDF-файлы». Страницы будут собраны в порядке списка — от первого файла к последнему.",
  "Нажмите «Скачать PDF», чтобы сохранить файл obedinyonny-pdf.pdf. Для новых файлов используйте «Очистить список».",
];

const faqs = [
  {
    q: "Как объединить PDF-файлы?",
    a: "Добавьте PDF в инструмент, расположите их в нужном порядке стрелками и нажмите «Объединить PDF-файлы». Новый файл будет содержать все страницы в порядке списка, и его можно скачать за несколько секунд.",
  },
  {
    q: "Это бесплатно?",
    a: "Да. Инструмент бесплатный, не требует регистрации и установки программ.",
  },
  {
    q: "Загружаются ли мои файлы на сервер?",
    a: "Нет. Объединение выполняется целиком в вашем браузере, на вашем устройстве. Ничего не отправляется в Paul Digital или третьим лицам, а после закрытия страницы ничего не сохраняется.",
  },
  {
    q: "Можно ли изменить порядок файлов?",
    a: "Да. Используйте стрелки вверх и вниз рядом с каждым файлом. Страницы первого файла в списке окажутся в итоговом PDF первыми. Отдельные файлы можно убрать кнопкой «Удалить файл».",
  },
  {
    q: "Сохраняются ли все страницы?",
    a: "Да. Все страницы каждого файла копируются без изменений и без повторного сжатия: текст, изображения и ссылки остаются как в оригинале. Закладки и интерактивные формы могут не сохраниться.",
  },
  {
    q: "Почему мой PDF не принимается?",
    a: "Инструмент отклоняет файлы, которые не являются PDF, пустые или повреждённые файлы и PDF с защитой паролем. Проблемный файл указывается в сообщении, остальные остаются в списке. Чтобы объединить защищённый PDF, сначала снимите пароль в программе, в которой вы открываете файл.",
  },
  {
    q: "Есть ли ограничения по размеру и числу файлов?",
    a: "Чтобы браузер работал стабильно, можно объединить до 30 файлов, не более 100 МБ каждый и 300 МБ в сумме. Поскольку всё обрабатывается в памяти устройства, очень большие файлы могут работать медленно на недорогих смартфонах.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "ru",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: site("/") },
    { "@type": "ListItem", position: 2, name: h1, item: site(path) },
  ],
};
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url: site(path),
  inLanguage: "ru",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Любая (в браузере)",
  browserRequirements: "Требуется JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Paul Digital", url: site("/") },
};
---

<BaseLayout title={title} description={description} canonicalUrl={path} lang="ru">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={json(appSchema)} />
    <script type="application/ld+json" set:html={json(faqSchema)} />
  </Fragment>
  <ToolTop h1={h1} intro={intro} crumbs={[{ label: "Главная", href: "/" }, { label: h1 }]} breadcrumbLabel="Навигационная цепочка">
    <MergePdf client:load locale="ru" />
  </ToolTop>
  <section class="content-section" style="padding-top: 0">
    <div class="container prose">
      <h2>Как объединить PDF-файлы</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>Об этом инструменте</h2>
      <p>
        «Объединить PDF» собирает несколько PDF-файлов в один документ: выберите файлы, задайте порядок и получите единый PDF без установки программ. Это удобно для договоров, чеков, резюме, дипломных работ, счетов и других документов, которые нужно отправить вместе.
      </p>
      <p>
        Страницы копируются без изменений в порядке списка. Инструмент не сжимает и не изменяет содержимое страниц — он просто собирает их в новый файл.
      </p>

      <h2>Ограничения инструмента</h2>
      <ul>
        <li><strong>Закладки и формы:</strong> закладки и интерактивные поля форм могут не сохраниться в объединённом файле.</li>
        <li><strong>Цифровые подписи:</strong> цифровая подпись в объединённом документе перестаёт быть действительной.</li>
        <li><strong>Защищённые файлы:</strong> PDF с паролем отклоняются; инструмент не снимает защиту. Файлы с проблемами не пропускаются молча: они указываются в сообщениях, чтобы вы могли исправить выбор.</li>
      </ul>

      <h2>Форматы и лимиты</h2>
      <p>
        <strong>Поддерживается:</strong> файлы .pdf без пароля, до 30 файлов, не более 100 МБ каждый и 300 МБ в сумме. Файлы с паролем, повреждённые и в других форматах отклоняются с пояснением причины.
      </p>

      <h2>Часто задаваемые вопросы</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <h2>Другие инструменты</h2>
      <ul class="ic-links">
        <li><a href="/razdelit-pdf/">Разделить PDF: извлеките нужные страницы</a></li>
        <li><a href="/szhat-pdf/">Сжать PDF: уменьшите размер PDF-файла</a></li>
        <li><a href="/pdf-v-word/">PDF в Word: преобразуйте PDF с текстом в документ DOCX</a></li>
        <li><a href="/word-v-pdf/">Word в PDF: преобразуйте документ .docx в PDF</a></li>
        <li><a href="/tools/" lang="en" hreflang="en">All tools (на английском): все инструменты сайта</a></li>
      </ul>

      <h2>Конфиденциальность</h2>
      <p>
        Ваши файлы обрабатываются целиком в браузере, на вашем устройстве. Они не отправляются в Paul Digital и на какие-либо другие серверы, а после закрытия страницы ничего не сохраняется.
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Paul Digital"
  description="Learn about Paul Digital, a developer of lightweight Android utilities and practical web tools."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>Useful software, thoughtfully made.</h1>
      <p>Paul Digital develops lightweight Android utilities and practical web tools for everyday tasks.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <h2>A practical approach</h2>
      <p>Paul Digital focuses on simple, fast and approachable digital utilities. The goal is to make tools that help with a task without unnecessary complexity.</p>
      <h2>Growing over time</h2>
      <p>This website brings together Paul Digital apps, web tools and practical guides.</p>
    </div>
  </section>
</BaseLayout>

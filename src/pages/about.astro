---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Paul Digital"
  description="Learn about Paul Digital and its lightweight Android utilities and practical browser-based tools."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>Useful software, thoughtfully made.</h1>
      <p>
        Paul Digital creates lightweight Android utilities and practical digital tools for
        everyday tasks, for people around the world.
      </p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <h2>Designed for everyday tasks</h2>
      <p>
        Paul Digital focuses on simple, fast and useful software. Apps and tools are designed
        around practical user experiences that help people complete everyday tasks without
        unnecessary complexity.
      </p>
      <h2>Lightweight and privacy-conscious</h2>
      <p>
        Lightweight performance and thoughtful handling of information are important
        considerations. Where technically appropriate, an app may support offline use; behavior
        and connectivity needs vary by app and feature. See the
        <a href="/privacy/">Privacy Policy</a> and the relevant app disclosures for details.
      </p>
      <h2>Apps, web tools and guides</h2>
      <p>
        Paul Digital develops Android apps and useful browser-based tools. Explore the
        <a href="/apps/">apps</a>, see the <a href="/tools/">web tools</a>, or read the
        <a href="/guides/">guides</a>.
      </p>
      <h2>Contact</h2>
      <p>
        For app support, feedback, or general and business inquiries, email
        <a href="mailto:askpaulonline@gmail.com">askpaulonline@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

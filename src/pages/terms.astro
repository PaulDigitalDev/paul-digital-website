---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms of Use — Paul Digital"
  description="Read the general Terms of Use for the Paul Digital website and apps."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Legal information</span>
      <h1>Terms of Use</h1>
      <p>General terms for using the Paul Digital website and apps.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <h2>Scope</h2>
      <p>
        These Terms of Use apply to your access to and use of the Paul Digital website and
        applications. Some apps or features may have additional terms or disclosures; those
        apply alongside these terms where relevant.
      </p>
      <h2>1. Acceptance of Terms</h2>
      <p>
        By accessing or using the website or an app, you agree to these terms. If you do not
        agree, do not use the relevant website or app.
      </p>
      <h2>2. Use of the Website and Apps</h2>
      <p>
        Use the website and apps lawfully and in accordance with the instructions and terms
        applicable to each service. Do not misuse, disrupt, or attempt to interfere with their
        normal operation.
      </p>
      <h2>3. App Availability and Updates</h2>
      <p>
        App availability, features, compatibility, and updates may vary by app, device, region,
        and Google Play availability. Updates may change, add, or remove features.
      </p>
      <h2>4. User Responsibilities</h2>
      <p>

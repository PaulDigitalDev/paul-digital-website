---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms — Paul Digital"
  description="Terms information for Paul Digital apps and services."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Legal information</span>
      <h1>Terms</h1>
      <p>Information about the use of Paul Digital apps and services.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <p class="notice">This outline does not establish product-specific or business terms.</p>
      <h2>Scope</h2>
      <p>Applicable terms identify the specific website, apps or services they cover.</p>
      <h2>Use of services</h2>
      <p>Terms for use describe the rules that apply to each service.</p>
      <h2>Availability and changes</h2>
      <p>Terms for each service explain applicable availability, updates and changes.</p>
    </div>
  </section>
</BaseLayout>
